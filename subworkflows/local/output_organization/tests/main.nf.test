        }
    }

    test("Should organize outputs with long file paths") {

        when {
            workflow {
                """
                input[0] = [
                    [
                        [id: 'long_name_sample', single_end: true],
                        file('$projectDir/tests/fixtures/reports/qc/fastp_report.html')
                    ]
                ]
                input[1] = [
                    [
                        [id: 'long_name_sample', single_end: true],
                        file('$projectDir/tests/fixtures/reports/qc/nanoplot_report.html')
                    ]
                ]
                input[2] = [
                    [
                        [id: 'long_name_sample', single_end: true],
                        file('$projectDir/tests/fixtures/reports/classification/kraken2_report.txt')
                    ]
                ]
                input[3] = [
                    [
                        [id: 'long_name_sample', single_end: true],
                        file('$projectDir/tests/fixtures/reports/validation/blast_results.txt')
                    ]
                ]
                input[4] = [
                    file('$projectDir/tests/fixtures/reports/multiqc/multiqc_report.html')
                ]
                """
            }

            params {
                outdir = '$outputDir/long_path_organized_results'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()
            assert workflow.out.qc_outputs
            assert workflow.out.classification_outputs
            assert workflow.out.validation_outputs
