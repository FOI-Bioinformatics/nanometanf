nextflow_workflow {

    name "Test QC_ANALYSIS"
    script "../main.nf"
    workflow "QC_ANALYSIS"

    // Test Level & Component
    tag "subworkflow"
    tag "qc_analysis"

    // Feature Area
    tag "qc"

    // Execution Speed & Criticality
    tag "medium"
    tag "core"

    // Test Type
    tag "edge_case"
    tag "snapshot"

    test("Should perform basic FASTP quality control") {

        when {
            workflow {
                """
                input[0] = [
                    [id: 'basic_qc_test', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                skip_fastp = false
                skip_nanoplot = true
                skip_fastqc = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.reads
            assert workflow.out.qc_reports

            // Verify FASTP processing
            def qc_reads = workflow.out.reads.toList()
            assert qc_reads.size() >= 1

            def qc_reports = workflow.out.qc_reports.toList()
            assert qc_reports.size() >= 1
        }
    }

    test("Should perform comprehensive nanopore QC with multiple tools") {

        when {
            workflow {
                """
                input[0] = [
                    [id: 'comprehensive_qc_test', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                skip_fastp = false
                skip_nanoplot = false
                skip_fastqc = false
                enable_filtlong = true
                enable_porechop = true
                enable_seqkit_stats = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '3.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.reads
            assert workflow.out.qc_reports
            assert workflow.out.nanoplot

            // Verify multiple QC tools ran
            def qc_reads = workflow.out.reads.toList()
            assert qc_reads.size() >= 1

            def qc_reports = workflow.out.qc_reports.toList()
            assert qc_reports.size() >= 1

            // Verify nanopore-specific QC
            if (workflow.out.nanoplot) {
                def nanoplot_reports = workflow.out.nanoplot.toList()
                assert nanoplot_reports.size() >= 1
            }
        }
    }

    test("Should handle FILTLONG nanopore-optimized filtering") {

        when {
            workflow {
                """
                input[0] = [
                    [id: 'filtlong_test', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'filtlong'
                filtlong_min_length = 1000
                filtlong_keep_percent = 90
                filtlong_target_bases = 500000000
                skip_fastp = true
                skip_nanoplot = true
                skip_fastqc = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.reads

            // Verify FILTLONG processing
            def qc_reads = workflow.out.reads.toList()
            assert qc_reads.size() >= 1
        }
    }

    test("Should perform adapter trimming with PORECHOP") {

        when {
            workflow {
                """
                input[0] = [
                    [id: 'porechop_test', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                enable_porechop = true
                porechop_discard_middle = true
                porechop_extra_end_trim = 2
                skip_nanoplot = true
                skip_fastqc = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.reads

            // Verify adapter trimming occurred
            def qc_reads = workflow.out.reads.toList()
            assert qc_reads.size() >= 1
        }
    }

    test("Should generate comprehensive nanopore statistics") {

        when {
            workflow {
                """
                input[0] = [
                    [id: 'stats_test', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'chopper'
                chopper_quality = 10
                chopper_minlength = 1000
                skip_nanoplot = false
                nanoplot_format = 'png'
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.reads
            assert workflow.out.qc_reports
            assert workflow.out.seqkit_stats

            // Verify statistics generation (CHOPPER always runs SEQKIT_STATS)
            def stats_reports = workflow.out.seqkit_stats.toList()
            assert stats_reports.size() >= 1

            // Verify NanoPlot visualization
            if (workflow.out.nanoplot) {
                def nanoplot_reports = workflow.out.nanoplot.toList()
                assert nanoplot_reports.size() >= 1
            }
        }
    }

    test("Should skip NanoPlot when input reads are empty (F5 regression)") {
        // Regression for F5 (P1-2): NanoPlot used to exit non-zero when handed
        // a zero-read FASTQ (for instance a sample where every read was
        // filtered out upstream), aborting the whole run. The subworkflow now
        // filters empty reads before passing them to NanoPlot, so the workflow
        // must complete and simply emit no NanoPlot output for that sample.
        when {
            workflow {
                """
                input[0] = [
                    [id: 'empty_reads', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/edge_cases/empty_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                skip_fastp = true
                skip_nanoplot = false
                skip_fastqc = true
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Should skip NanoPlot for sub-50-byte gzip-only post-QC FASTQ (Task #12 regression)") {

        tag "task12"

        // Regression for Task #12: Chopper and fastp can emit a gzipped FASTQ
        // that contains only the gzip framing (no records) when every input
        // read fails the configured quality or length thresholds. The earlier
        // guard relied on `size() > 0`, which let the ~20-40 byte framing pass
        // through and caused NanoPlot to abort the pipeline with
        // "Fatal: No reads found in input". The current guard uses the same
        // 50-byte threshold as the TAXONOMIC_CLASSIFICATION entry guard
        // (commit e8b8dfe), so the sample is dropped and the workflow
        // completes successfully.
        when {
            workflow {
                """
                input[0] = [
                    [id: 'barcode03_empty_post_qc', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/edge_cases/empty_post_qc.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                skip_fastp = true
                skip_nanoplot = false
                skip_fastqc = true
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            assert workflow.success

            // NanoPlot was skipped, so no html output for the empty sample.
            if (workflow.out.nanoplot) {
                def html_list = workflow.out.nanoplot.toList()
                assert html_list.size() == 0
            }
        }
    }

    test("Should handle multiple samples in batch processing") {

        when {
            workflow {
                """
                input[0] = [
                    [
                        [id: 'batch_sample1', single_end: true],
                        file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                    ],
                    [
                        [id: 'batch_sample2', single_end: true],
                        file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                    ],
                    [
                        [id: 'batch_sample3', single_end: true],
                        file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                    ]
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                skip_nanoplot = true
                skip_fastqc = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '3.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.reads
            assert workflow.out.qc_reports

            // Verify batch processing
            def qc_reads = workflow.out.reads.toList()
            assert qc_reads.size() >= 3

            def qc_reports = workflow.out.qc_reports.toList()
            assert qc_reports.size() >= 3
        }
    }

    test("Should handle quality-based filtering with custom thresholds") {

        when {
            workflow {
                """
                input[0] = [
                    [id: 'quality_filter_test', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                fastp_qualified_quality_phred = 15
                fastp_unqualified_percent_limit = 20
                fastp_length_required = 1000
                fastp_cut_front_window_size = 4
                fastp_cut_front_mean_quality = 20
                skip_nanoplot = true
                skip_fastqc = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.reads
            assert workflow.out.qc_reports

            // Verify quality filtering
            def qc_reads = workflow.out.reads.toList()
            assert qc_reads.size() >= 1

            def qc_reports = workflow.out.qc_reports.toList()
            assert qc_reports.size() >= 1
        }
    }

    test("Should handle FastQC analysis for general quality assessment") {

        when {
            workflow {
                """
                input[0] = [
                    [id: 'fastqc_test', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'filtlong'
                filtlong_min_length = 1000
                filtlong_keep_percent = 90
                skip_nanoplot = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.fastqc_html

            // Verify FastQC analysis (FILTLONG always runs FastQC)
            def fastqc_reports = workflow.out.fastqc_html.toList()
            assert fastqc_reports.size() >= 1
        }
    }

    test("Should handle edge cases with small or malformed files") {

        when {
            workflow {
                """
                input[0] = [
                    [
                        [id: 'tiny_test', single_end: true],
                        file('$projectDir/tests/fixtures/fastq/edge_cases/tiny_sample.fastq.gz')
                    ],
                    [
                        [id: 'empty_test', single_end: true],
                        file('$projectDir/tests/fixtures/fastq/edge_cases/empty_sample.fastq.gz')
                    ]
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                skip_nanoplot = true
                skip_fastqc = true
                fastp_dont_eval_duplication = true
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            // Should handle edge cases gracefully
            assert workflow.success
            assert workflow.out.versions

            // Previously: three nested guards around `size() >= 0`, which is
            // true of every list -- so the block asserted nothing at all.
            // The real contract for an edge-case input is that whatever is
            // emitted is well formed, not that some list exists.
            workflow.out.qc_reads.toList().each { entry ->
                assert entry instanceof List && entry.size() >= 2 :
                    "malformed qc_reads entry: ${entry}"
                assert entry[0]?.id : "qc_reads entry has no sample id: ${entry}"
            }
        }
    }

    test("Should run minimal QC with skip options") {

        when {
            workflow {
                """
                input[0] = [
                    [id: 'minimal_qc_test', single_end: true],
                    file('$projectDir/tests/fixtures/fastq/test_sample.fastq.gz')
                ]
                """
            }

            params {
                qc_tool = 'fastp'
                skip_fastp = false
                skip_nanoplot = true
                skip_fastqc = true
                enable_filtlong = false
                enable_porechop = false
                enable_seqkit_stats = false
                fastp_save_trimmed_fail = false
                fastp_save_merged = false
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions
            assert workflow.out.reads

            // Verify minimal processing
            def qc_reads = workflow.out.reads.toList()
            assert qc_reads.size() >= 1
        }
    }

    test("Should validate QC workflow with no input files") {

        when {
            workflow {
                """
                input[0] = []
                """
            }

            params {
                qc_tool = 'fastp'
                skip_fastp = false
                max_cpus = 1
                max_memory = '1.GB'
                max_time = '30.s'
            }
        }

        then {
            // Should handle empty input gracefully -- with no input
            // files the versions channel is also empty, so we cannot
            // assert ``workflow.out.versions`` here.
            assert workflow.success

            if (workflow.success) {
                // Empty outputs expected
                if (workflow.out.qc_reads) {
                    def qc_reads = workflow.out.qc_reads.toList()
                    assert qc_reads.size() == 0
                }
            }
        }
    }
}
