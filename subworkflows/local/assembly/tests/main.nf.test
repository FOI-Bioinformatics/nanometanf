nextflow_workflow {

    name "Test ASSEMBLY"
    script "../main.nf"
    workflow "ASSEMBLY"

    tag "subworkflow"
    tag "assembly"
    tag "stub"
    tag "fast"

    // The subworkflow takes TWO channels: whole-sample reads and per-organism
    // (reads, reference) pairs. An earlier version of this file called it with
    // one and every case failed at parse time ("declares 2 inputs but was
    // called with 1 argument"), which is why the file sat in
    // tests/ci_excluded_tests.txt as unverified. Stub mode: the depth gate's
    // stub records 'attempt' for every candidate, so the assembler branch
    // runs; the module stubs still evaluate `<tool> --version`, so the tools
    // must resolve (conda or docker profile), as for every stub test here.

    test("metagenome scope: one decision and one flye attempt per sample") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([ [id: 'asm1', single_end: true],
                                        file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.empty()
                """
            }
            params {
                assembler = 'flye'
                assembly_scope = 'metagenome'
                realtime_mode = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.assembler_used == ['flye']
            assert workflow.out.decision.size() == 1
            assert workflow.out.decision[0][1].endsWith('asm1.assembly_decision.json')
            assert workflow.out.assembly.size() == 1
            assert workflow.out.assembly[0][1].endsWith('asm1.assembly.fasta.gz')
            assert workflow.out.assembly_graph.size() == 1
            assert workflow.out.assembly_info.size() == 1
            assert workflow.out.canonical_assembly.size() == 1
            assert workflow.out.versions
        }
    }

    test("targeted scope assembles the per-organism reads and ignores whole-sample reads") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([ [id: 'asm1', single_end: true],
                                        file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.of([ [id: 'asm1', single_end: true, taxid: 562],
                                        file('${projectDir}/tests/fixtures/fastq/barcode01.fastq.gz'),
                                        file('${projectDir}/tests/fixtures/fasta/query_sequences.fasta') ])
                """
            }
            params {
                assembler = 'flye'
                assembly_scope = 'targeted'
                realtime_mode = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.decision.size() == 1
            assert workflow.out.decision[0][1].endsWith('asm1.taxid562.assembly_decision.json')
            assert workflow.out.decision[0][0].assembly_scope == 'targeted'
            assert workflow.out.assembly.size() == 1
        }
    }

    test("scope both: one decision per candidate, whole-sample and targeted") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([ [id: 'asm1', single_end: true],
                                        file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.of([ [id: 'asm1', single_end: true, taxid: 562],
                                        file('${projectDir}/tests/fixtures/fastq/barcode01.fastq.gz'),
                                        file('${projectDir}/tests/fixtures/fasta/query_sequences.fasta') ])
                """
            }
            params {
                assembler = 'flye'
                assembly_scope = 'both'
                realtime_mode = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.decision.size() == 2
            assert workflow.out.decision.collect { it[0].assembly_scope }.sort() == ['metagenome', 'targeted']
            assert workflow.out.assembly.size() == 2
        }
    }

    test("two samples in batch mode get one attempt each") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ [id: 'barcode01', single_end: true], file('${projectDir}/tests/fixtures/fastq/barcode01.fastq.gz') ],
                    [ [id: 'barcode02', single_end: true], file('${projectDir}/tests/fixtures/fastq/barcode02.fastq.gz') ]
                )
                input[1] = Channel.empty()
                """
            }
            params {
                assembler = 'flye'
                assembly_scope = 'metagenome'
                realtime_mode = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.decision.collect { it[0].id }.sort() == ['barcode01', 'barcode02']
            assert workflow.out.assembly.collect { it[0].id }.sort() == ['barcode01', 'barcode02']
        }
    }

    // Chunked batch mode emits a sample once per chunk. The subworkflow groups
    // the chunks by assembly key before pooling, so one sample gets one decision
    // and one attempt built on every chunk, whatever order the chunks arrive in.
    test("chunked emissions of one sample are pooled into a single attempt") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ [id: 'chunky', single_end: true, batch_id: 1, chunk_count: 2], file('${projectDir}/tests/fixtures/fastq/barcode02.fastq.gz') ],
                    [ [id: 'chunky', single_end: true, batch_id: 0, chunk_count: 2], file('${projectDir}/tests/fixtures/fastq/barcode01.fastq.gz') ]
                )
                input[1] = Channel.empty()
                """
            }
            params {
                assembler = 'flye'
                assembly_scope = 'metagenome'
                realtime_mode = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.decision.size() == 1
            assert workflow.out.assembly.size() == 1
            // The chunk fields describe an emission, not the sample, and must
            // not reach the whole-sample artifact's meta.
            assert !workflow.out.decision[0][0].containsKey('batch_id')
            assert !workflow.out.decision[0][0].containsKey('chunk_count')
        }
    }

    test("miniasm takes the all-vs-all overlap path and reports no assembly info") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([ [id: 'asm1', single_end: true],
                                        file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.empty()
                """
            }
            params {
                assembler = 'miniasm'
                assembly_scope = 'metagenome'
                realtime_mode = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.assembler_used == ['miniasm']
            assert workflow.out.decision.size() == 1
            assert workflow.out.assembly.size() == 1
            assert workflow.out.assembly_graph.size() == 1
            // Miniasm writes no assembly_info, so the canonical writer does not run.
            assert workflow.out.canonical_assembly.size() == 0
        }
    }

    test("empty input completes and records no decision") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.empty()
                input[1] = Channel.empty()
                """
            }
            params {
                assembler = 'flye'
                assembly_scope = 'both'
                realtime_mode = false
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.decision.size() == 0
            assert workflow.out.canonical_assembly.size() == 0
        }
    }

    test("an unsupported assembler is refused by name") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([ [id: 'asm1', single_end: true],
                                        file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.empty()
                """
            }
            params {
                assembler = 'bogus_assembler'
                assembly_scope = 'metagenome'
                realtime_mode = false
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            assert workflow.failed
            // `error` raised at workflow definition time reaches nf-test's
            // captured stdout, not workflow.errorReport (which stays empty).
            assert workflow.stdout.any { it.contains('Unsupported assembler: bogus_assembler') }
        }
    }
}
