nextflow_workflow {

    name "Test VALIDATION subworkflow"
    script "../main.nf"
    workflow "VALIDATION"

    // Test Level & Component
    tag "subworkflow"
    tag "validation"

    // Feature Area
    tag "regression"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"
    tag "stub"

    // Regression cover for the June 4 2026 batch-mode crash: in batch mode
    // ``meta`` carries no ``batch_id``, so the realtime cumulative aggregators
    // (MINIMAP2_/BLAST_CUMULATIVE_AGGREGATOR) are skipped. The version mixes
    // previously used ``.first().ifEmpty([])``, so a skipped aggregator
    // injected an empty list ``[]`` into the emitted ``versions`` channel. At
    // the pipeline level the nf-core ``softwareVersionsToYAML`` helper then
    // called ``Yaml.load([])`` and aborted the run with MethodSelectionException.
    // The fix drops ``.ifEmpty([])`` (an empty channel contributes nothing), so
    // ``versions`` must contain only real files and never an empty list.

    test("batch-mode minimap2 validation emits no empty-list versions entry") {

        options "-stub"

        when {
            workflow {
                """
                // meta WITHOUT batch_id => batch mode => cumulative aggregator skipped
                input[0] = Channel.of([ [id: 'val_batch', single_end: true],
                             file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.of([ [id: 'val_batch', single_end: true],
                             file('${projectDir}/tests/fixtures/validation/test_kraken_output.txt') ])
                input[2] = Channel.of([ [id: 'val_batch', single_end: true],
                             file('${projectDir}/tests/fixtures/reports/classification/kraken2_report.txt') ])
                input[3] = file('${projectDir}/tests/fixtures/validation/test_genomes.json')
                input[4] = 'all'
                input[5] = 'minimap2'
                """
            }

            params {
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            // The regression: no emitted versions item may be an empty list.
            assert !workflow.out.versions.any { it instanceof List && it.isEmpty() }
            // And real version files must still be collected.
            assert workflow.out.versions.size() > 0
        }
    }

    test("batch-mode blast validation emits no empty-list versions entry") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([ [id: 'val_batch', single_end: true],
                             file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.of([ [id: 'val_batch', single_end: true],
                             file('${projectDir}/tests/fixtures/validation/test_kraken_output.txt') ])
                input[2] = Channel.of([ [id: 'val_batch', single_end: true],
                             file('${projectDir}/tests/fixtures/reports/classification/kraken2_report.txt') ])
                input[3] = file('${projectDir}/tests/fixtures/validation/test_genomes.json')
                input[4] = 'all'
                input[5] = 'blast'
                """
            }

            params {
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert !workflow.out.versions.any { it instanceof List && it.isEmpty() }
            assert workflow.out.versions.size() > 0
        }
    }

    // Realtime mode rebuilds validation_results.json each batch from the
    // per-(sample, taxid) cumulative stats instead of deferring a single
    // .collect()-gated aggregation to the end of the watchPath stream. With
    // meta.batch_id set the cumulative aggregators run and feed
    // AGGREGATE_VALIDATION_LIVE, so the JSON must be emitted during the run.
    test("realtime-mode validation emits validation_results.json from cumulative stats") {

        options "-stub"

        when {
            workflow {
                """
                // meta WITH batch_id => realtime mode => live aggregation path
                input[0] = Channel.of([ [id: 'val_rt', single_end: true, batch_id: 'batch_0'],
                             file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.of([ [id: 'val_rt', single_end: true, batch_id: 'batch_0'],
                             file('${projectDir}/tests/fixtures/validation/test_kraken_output.txt') ])
                input[2] = Channel.of([ [id: 'val_rt', single_end: true, batch_id: 'batch_0'],
                             file('${projectDir}/tests/fixtures/reports/classification/kraken2_report.txt') ])
                input[3] = file('${projectDir}/tests/fixtures/validation/test_genomes.json')
                input[4] = 'all'
                input[5] = 'both'
                """
            }

            params {
                realtime_mode = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            // The realtime fix: the JSON is produced via the live path, not the
            // end-of-run .collect() barrier.
            assert workflow.out.validation_json
            assert workflow.out.validation_json.size() > 0
            assert !workflow.out.versions.any { it instanceof List && it.isEmpty() }
        }
    }

    // The realtime species-name fix routes per-batch Kraken2 reports into
    // validation; the live snapshot keys reports by id|batch_id with an explicit
    // null check so batch_id 0 (the first batch, a Groovy-falsy value) is not
    // mistaken for the no-batch_id cumulative report. This case uses an integer
    // batch_id 0 throughout and asserts the run still produces the JSON.
    test("realtime-mode validation handles integer batch_id 0") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([ [id: 'val_rt', single_end: true, batch_id: 0],
                             file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz') ])
                input[1] = Channel.of([ [id: 'val_rt', single_end: true, batch_id: 0],
                             file('${projectDir}/tests/fixtures/validation/test_kraken_output.txt') ])
                input[2] = Channel.of([ [id: 'val_rt', single_end: true, batch_id: 0],
                             file('${projectDir}/tests/fixtures/reports/classification/kraken2_report.txt') ])
                input[3] = file('${projectDir}/tests/fixtures/validation/test_genomes.json')
                input[4] = 'all'
                input[5] = 'both'
                """
            }

            params {
                realtime_mode = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.validation_json
            assert workflow.out.validation_json.size() > 0
        }
    }

    // Deadlock reproducer (issue #29). In realtime mode each (sample, taxid) key
    // recurs once per batch, so the validation fan-out joins -- keyed on
    // (id, taxid) with no batch dimension -- see DUPLICATE keys across batches.
    // A live run with several batches and multiple taxids wedged with ~1300
    // tasks pending and 0 running. This case emits 3 batches for one sample
    // against 2 taxids (562, 28901) so each (id, taxid) key appears 3x. If the
    // subworkflow drains and emits the JSON the topology is sound; if it hangs
    // it fails on max_time, pinning the deadlock.
    test("realtime-mode multi-batch validation drains with repeated (sample,taxid) keys") {

        options "-stub"

        when {
            workflow {
                """
                def reads  = file('${projectDir}/tests/fixtures/fastq/test_sample.fastq.gz')
                def kraken = file('${projectDir}/tests/fixtures/validation/test_kraken_output.txt')
                def report = file('${projectDir}/tests/fixtures/reports/classification/kraken2_report.txt')
                input[0] = Channel.of(
                    [ [id: 'val_rt', single_end: true, batch_id: 0], reads ],
                    [ [id: 'val_rt', single_end: true, batch_id: 1], reads ],
                    [ [id: 'val_rt', single_end: true, batch_id: 2], reads ] )
                input[1] = Channel.of(
                    [ [id: 'val_rt', single_end: true, batch_id: 0], kraken ],
                    [ [id: 'val_rt', single_end: true, batch_id: 1], kraken ],
                    [ [id: 'val_rt', single_end: true, batch_id: 2], kraken ] )
                // Per-batch reports must have UNIQUE basenames, exactly as the
                // real KRAKEN2_REPORT_GENERATOR emits (id_batchN.kraken2.report.txt);
                // reusing one name triggers an unrelated staging collision.
                input[2] = Channel.of(
                    [ [id: 'val_rt', single_end: true, batch_id: 0], file('${projectDir}/tests/fixtures/validation/multibatch/val_rt_batch0.kraken2.report.txt') ],
                    [ [id: 'val_rt', single_end: true, batch_id: 1], file('${projectDir}/tests/fixtures/validation/multibatch/val_rt_batch1.kraken2.report.txt') ],
                    [ [id: 'val_rt', single_end: true, batch_id: 2], file('${projectDir}/tests/fixtures/validation/multibatch/val_rt_batch2.kraken2.report.txt') ] )
                input[3] = file('${projectDir}/tests/fixtures/validation/test_genomes.json')
                input[4] = 'all'
                input[5] = 'both'
                """
            }

            params {
                realtime_mode = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.out.validation_json
            assert workflow.out.validation_json.size() > 0
        }
    }
}
