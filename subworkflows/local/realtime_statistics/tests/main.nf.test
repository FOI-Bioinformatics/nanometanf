nextflow_workflow {

    name "Test REALTIME_STATISTICS"
    script "../main.nf"
    workflow "REALTIME_STATISTICS"

    // Test Level & Component
    tag "subworkflow"
    tag "realtime_statistics"

    // Feature Area
    tag "realtime"

    // Execution Speed & Criticality
    tag "medium"
    tag "core"

    test("Should generate snapshot statistics for single batch") {

        when {
            workflow {
                """
                def batch_meta = [
                    batch_id: 'batch_001',
                    timestamp: '2023-12-01T10:00:00',
                    file_count: 3,
                    total_size: 1500000
                ]

                def file_metas = [
                    [id: 'file1', path: file('$projectDir/tests/fixtures/fastq/batch/file1.fastq')],
                    [id: 'file2', path: file('$projectDir/tests/fixtures/fastq/batch/file2.fastq')],
                    [id: 'file3', path: file('$projectDir/tests/fixtures/fastq/batch/file3.fastq')]
                ]

                input[0] = [ [batch_meta, file_metas] ]
                input[1] = [
                    enable_quality_indicators: true,
                    enable_source_analysis: true,
                    enable_timing_analysis: true,
                    stats_interval: '10s',
                    report_format: 'html,json'
                ]
                """
            }

            params {
                outdir = '$outputDir/results'
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '3.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()
            assert workflow.out.snapshot_stats
            assert workflow.out.cumulative_stats
            assert workflow.out.realtime_reports
            assert workflow.out.versions

            def snapshot_stats = workflow.out.snapshot_stats.toList()
            assert snapshot_stats.size() >= 1

            def cumulative_stats = workflow.out.cumulative_stats.toList()
            assert cumulative_stats.size() >= 1

            def realtime_reports = workflow.out.realtime_reports.toList()
            assert realtime_reports.size() >= 1

            def versions = workflow.out.versions.toList()
            assert versions.size() >= 3
        }
    }

    test("Should handle multiple batches and update cumulative statistics") {

        when {
            workflow {
                """
                def batches = [
                    [
                        [batch_id: 'batch_001', timestamp: '2023-12-01T10:00:00', file_count: 2, total_size: 1000000],
                        [
                            [id: 'batch1_file1', path: file('$projectDir/tests/fixtures/fastq/batch/file1.fastq')],
                            [id: 'batch1_file2', path: file('$projectDir/tests/fixtures/fastq/batch/file2.fastq')]
                        ]
                    ],
                    [
                        [batch_id: 'batch_002', timestamp: '2023-12-01T10:05:00', file_count: 3, total_size: 1500000],
                        [
                            [id: 'batch2_file1', path: file('$projectDir/tests/fixtures/fastq/batch/file3.fastq')],
                            [id: 'batch2_file2', path: file('$projectDir/tests/fixtures/fastq/batch/file4.fastq')],
                            [id: 'batch2_file3', path: file('$projectDir/tests/fixtures/fastq/batch/file5.fastq')]
                        ]
                    ],
                    [
                        [batch_id: 'batch_003', timestamp: '2023-12-01T10:10:00', file_count: 1, total_size: 500000],
                        [
                            [id: 'batch3_file1', path: file('$projectDir/tests/fixtures/fastq/batch/file6.fastq')]
                        ]
                    ]
                ]

                input[0] = batches
                input[1] = [
                    enable_quality_indicators: true,
                    enable_source_analysis: true,
                    enable_timing_analysis: true,
                    generate_cumulative_stats: true,
                    stats_interval: '5s',
                    report_format: 'html,json'
                ]
                """
            }

            params {
                outdir = '$outputDir/results'
                max_cpus = 4
                max_memory = '8.GB'
                max_time = '5.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()
            assert workflow.out.snapshot_stats
            assert workflow.out.cumulative_stats
            assert workflow.out.realtime_reports

            def snapshot_stats = workflow.out.snapshot_stats.toList()
            assert snapshot_stats.size() >= 3

            def cumulative_stats = workflow.out.cumulative_stats.toList()
            assert cumulative_stats.size() >= 3

            def realtime_reports = workflow.out.realtime_reports.toList()
            assert realtime_reports.size() >= 3

            if (workflow.out.alert_notifications) {
                def alerts = workflow.out.alert_notifications.toList()
                assert alerts.size() >= 0
            }
        }
    }

    test("Should generate quality indicators and performance metrics") {

        when {
            workflow {
                """
                def quality_batches = [
                    [
                        [batch_id: 'hq_batch_001', timestamp: '2023-12-01T12:00:00', file_count: 2, total_size: 2000000, quality_level: 'high'],
                        [
                            [id: 'hq_file1', path: file('$projectDir/tests/fixtures/fastq/batch/hq_file1.fastq')],
                            [id: 'hq_file2', path: file('$projectDir/tests/fixtures/fastq/batch/hq_file2.fastq')]
                        ]
                    ],
                    [
                        [batch_id: 'mq_batch_001', timestamp: '2023-12-01T12:05:00', file_count: 2, total_size: 1800000, quality_level: 'mixed'],
                        [
                            [id: 'mq_file1', path: file('$projectDir/tests/fixtures/fastq/batch/mq_file1.fastq')],
                            [id: 'mq_file2', path: file('$projectDir/tests/fixtures/fastq/batch/mq_file2.fastq')]
                        ]
                    ]
                ]

                input[0] = quality_batches
                input[1] = [
                    enable_quality_indicators: true,
                    enable_source_analysis: true,
                    enable_timing_analysis: true,
                    enable_performance_monitoring: true,
                    quality_threshold_warnings: true,
                    quality_score_min: 20,
                    stats_interval: '5s',
                    report_format: 'html,json'
                ]
                """
            }

            params {
                outdir = '$outputDir/results'
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '4.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()
            assert workflow.out.snapshot_stats
            assert workflow.out.cumulative_stats
            assert workflow.out.realtime_reports

            def snapshot_stats = workflow.out.snapshot_stats.toList()
            assert snapshot_stats.size() >= 2

            def cumulative_stats = workflow.out.cumulative_stats.toList()
            assert cumulative_stats.size() >= 2

            def realtime_reports = workflow.out.realtime_reports.toList()
            assert realtime_reports.size() >= 2
        }
    }

    test("Should handle real-time alerting and notifications") {

        when {
            workflow {
                """
                def alert_batches = [
                    [
                        [batch_id: 'normal_batch_001', timestamp: '2023-12-01T14:00:00', file_count: 3, total_size: 2000000],
                        [
                            [id: 'normal_file1', path: file('$projectDir/tests/fixtures/fastq/batch/hq_file1.fastq')],
                            [id: 'normal_file2', path: file('$projectDir/tests/fixtures/fastq/batch/hq_file2.fastq')],
                            [id: 'normal_file3', path: file('$projectDir/tests/fixtures/fastq/batch/file1.fastq')]
                        ]
                    ],
                    [
                        [batch_id: 'problem_batch_001', timestamp: '2023-12-01T14:05:00', file_count: 1, total_size: 100000],
                        [
                            [id: 'problem_file1', path: file('$projectDir/tests/fixtures/fastq/batch/problem_file1.fastq')]
                        ]
                    ]
                ]

                input[0] = alert_batches
                input[1] = [
                    enable_quality_indicators: true,
                    enable_source_analysis: true,
                    enable_timing_analysis: true,
                    quality_threshold_warnings: true,
                    alert_on_low_quality: true,
                    alert_on_low_throughput: true,
                    min_file_count_per_batch: 2,
                    min_batch_size: 500000,
                    quality_score_min: 15,
                    stats_interval: '5s',
                    report_format: 'html,json'
                ]
                """
            }

            params {
                outdir = '$outputDir/results'
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '4.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()
            assert workflow.out.snapshot_stats
            assert workflow.out.cumulative_stats
            assert workflow.out.realtime_reports

            def snapshot_stats = workflow.out.snapshot_stats.toList()
            assert snapshot_stats.size() >= 2

            def cumulative_stats = workflow.out.cumulative_stats.toList()
            assert cumulative_stats.size() >= 2

            if (workflow.out.alert_notifications) {
                def alerts = workflow.out.alert_notifications.toList()
                assert alerts.size() >= 0
            }
        }
    }

    test("Should handle different statistics configuration options") {

        when {
            workflow {
                """
                def config_batch = [
                    [
                        [batch_id: 'config_batch_001', timestamp: '2023-12-01T16:00:00', file_count: 2, total_size: 1500000],
                        [
                            [id: 'config_file1', path: file('$projectDir/tests/fixtures/fastq/batch/file1.fastq')],
                            [id: 'config_file2', path: file('$projectDir/tests/fixtures/fastq/batch/file2.fastq')]
                        ]
                    ]
                ]

                input[0] = config_batch
                input[1] = [
                    enable_quality_indicators: false,
                    enable_source_analysis: true,
                    enable_timing_analysis: false,
                    enable_performance_monitoring: true,
                    generate_cumulative_stats: true,
                    stats_interval: '30s',
                    report_format: 'json',
                    custom_metrics: ['file_size_distribution', 'read_length_distribution']
                ]
                """
            }

            params {
                outdir = '$outputDir/results'
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '3.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()
            assert workflow.out.snapshot_stats
            assert workflow.out.cumulative_stats
            assert workflow.out.realtime_reports

            def snapshot_stats = workflow.out.snapshot_stats.toList()
            assert snapshot_stats.size() >= 1

            def cumulative_stats = workflow.out.cumulative_stats.toList()
            assert cumulative_stats.size() >= 1

            def realtime_reports = workflow.out.realtime_reports.toList()
            assert realtime_reports.size() >= 1
        }
    }

    test("Should handle empty batch input gracefully") {

        when {
            workflow {
                """
                input[0] = []
                input[1] = [
                    enable_quality_indicators: true,
                    enable_source_analysis: true,
                    enable_timing_analysis: true,
                    stats_interval: '10s',
                    report_format: 'html,json'
                ]
                """
            }

            params {
                outdir = '$outputDir/results'
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()

            if (workflow.out.snapshot_stats) {
                def snapshot_stats = workflow.out.snapshot_stats.toList()
                assert snapshot_stats.size() == 0
            }

            if (workflow.out.cumulative_stats) {
                def cumulative_stats = workflow.out.cumulative_stats.toList()
                assert cumulative_stats.size() == 0
            }

            if (workflow.out.realtime_reports) {
                def realtime_reports = workflow.out.realtime_reports.toList()
                assert realtime_reports.size() == 0
            }
        }
    }

    test("Should validate resource requirements for large batches") {

        when {
            workflow {
                """
                // Nextflow v2 strict grammar rejects classic Java
                // ``for (int i = ...)`` loops; use the Groovy range each.
                def files = []
                (1..20).each { i ->
                    files.add([id: "large_file_" + i, path: file('$projectDir/tests/fixtures/fastq/batch/large_file_' + i + '.fastq')])
                }

                def large_batch = [
                    [
                        [batch_id: 'large_batch_001', timestamp: '2023-12-01T18:00:00', file_count: 20, total_size: 50000000],
                        files
                    ]
                ]

                input[0] = large_batch
                input[1] = [
                    enable_quality_indicators: true,
                    enable_source_analysis: true,
                    enable_timing_analysis: true,
                    enable_performance_monitoring: true,
                    stats_interval: '15s',
                    report_format: 'html,json'
                ]
                """
            }

            params {
                outdir = '$outputDir/results'
                max_cpus = 4
                max_memory = '8.GB'
                max_time = '6.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()
            assert workflow.out.snapshot_stats
            assert workflow.out.cumulative_stats
            assert workflow.out.realtime_reports

            def snapshot_stats = workflow.out.snapshot_stats.toList()
            assert snapshot_stats.size() >= 1

            def cumulative_stats = workflow.out.cumulative_stats.toList()
            assert cumulative_stats.size() >= 1

            assert workflow.duration.toMillis() < 360000
        }
    }
}
