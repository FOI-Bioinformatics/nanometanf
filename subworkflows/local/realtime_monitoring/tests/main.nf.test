nextflow_workflow {

    name "Test REALTIME_MONITORING"
    script "../main.nf"
    workflow "REALTIME_MONITORING"

    // Test Level & Component
    tag "subworkflow"
    tag "realtime_monitoring"

    // Feature Area
    tag "realtime"

    // Execution Speed & Criticality
    tag "medium"
    tag "core"

    test("Should handle disabled real-time mode gracefully") {

        when {
            workflow {
                """
                input[0] = '$outputDir/test_watch_dir'     // watch_dir
                input[1] = '**/*.fastq{,.gz}'              // file_pattern
                input[2] = 5                               // batch_size
                input[3] = '2.min'                         // batch_interval
                """
            }

            params {
                realtime_mode = false
                max_files = null
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()

            if (workflow.out.samples) {
                def samples = workflow.out.samples.toList()
                assert samples.size() == 0
            }
        }
    }

    test("Should default realtime_timeout_minutes to 60 (F12 regression)") {
        // Regression for F12 (P2-10): the default was null, which caused
        // unattended real-time runs to hang forever after the operator went
        // home. A 60-minute idle timeout gives the pipeline a chance to stop
        // itself cleanly.
        when {
            workflow {
                """
                input[0] = '$outputDir/test_watch_dir'     // watch_dir
                input[1] = '**/*.fastq{,.gz}'              // file_pattern
                input[2] = 5                               // batch_size
                input[3] = '2.min'                         // batch_interval
                """
            }

            params {
                realtime_mode = false
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '1.min'
            }
        }

        then {
            assert workflow.success
            // nf-test's then-block `params` reflects only the test's declared
            // params, not Nextflow's config-resolved params, so it cannot see a
            // config default. Assert the F12 default at its source instead: the
            // pipeline nextflow.config. Reading the shipped file (rather than
            // hardcoding 60 in a test config) keeps this a genuine guard -- it
            // fails if the default is removed or changed back to null. The repo
            // root is derived from nf_test_output, which always lives under
            // <repoRoot>/.nf-test/.
            def repoRoot = params.nf_test_output.split('/\\.nf-test/')[0]
            def pipelineConfig = new File("${repoRoot}/nextflow.config").text
            assert pipelineConfig =~ /(?m)^\s*realtime_timeout_minutes\s*=\s*60\b/
        }
    }

    test("Should accept both realtime_timeout_minutes and max_files (Task #10 regression)") {

        tag "task10"
        tag "hangs-on-jvm-cleanup"

        // Regression for Task #10: the subworkflow used to apply
        // .take(max_files) but never wired total_timeout_ms to the
        // channel, so the timeout was silently dropped when both bounds
        // were set. With max_files=50 and only 3 files delivered, the
        // run waited indefinitely for 47 more files instead of stopping
        // at the wall-clock budget.
        //
        // The fix mixes a sentinel emitted from a daemon Timer into the
        // file stream and applies .until on it before .take, so
        // whichever predicate is satisfied first terminates the merged
        // channel. This test mirrors the existing realtime_mode test
        // pattern: it walks the realtime branch with both bounds set so
        // a regression in the parameter-wiring (script-level errors,
        // bad timeout maths, missing imports) is caught at compile and
        // load time. The cap-fires-first and timeout-fires-first
        // behaviours are validated end-to-end at the integration level
        // (Scenarios C, D, E in the audit harness).
        when {
            workflow {
                """
                input[0] = '$projectDir/tests/fixtures/watch_dirs/fastq'   // watch_dir
                input[1] = '**/*.fastq{,.gz}'                              // file_pattern
                input[2] = 1                                               // batch_size
                input[3] = '30.sec'                                        // batch_interval
                """
            }

            params {
                realtime_mode = true
                realtime_timeout_minutes = 60
                realtime_processing_grace_period = 5
                max_files = 1
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Should flush partial batches on batch_timeout (BatchUtils 2026-05-01)") {

        tag "task26"
        tag "batchutils"
        tag "hangs-on-jvm-cleanup"

        // Regression for the 2026-05-01 update-frequency audit:
        // BatchUtils.batchWithTimeout used to ignore its timeoutSeconds
        // argument and fall back to plain buffer(size: N, remainder: true),
        // which only emits when the size threshold is reached or the
        // upstream channel closes. On low-throughput runs (single barcode,
        // slow MinKNOW release) a partial batch would sit at e.g. 0/10
        // forever, with no Kraken2 report produced until realtime_timeout
        // fired the upstream PoisonPill 60 minutes later.
        //
        // The test uses batch_size=2 with three fixture files. The first
        // two trigger the size-threshold flush (batch #1); the remaining
        // single file is held in the deque and emerges via the periodic
        // batch_timeout=2 timer (batch #2). Without the fix the third
        // file would wait until take(N) closed the upstream stream,
        // exercising only the close-flush path -- so we set
        // batch_timeout much shorter than the wall-clock window the
        // close path could otherwise hide it inside.
        //
        // We bound the run with max_files instead of
        // realtime_timeout_minutes because the latter triggers a known
        // JVM cleanup hang (see bin/run-nf-tests.sh / nf-test.config
        // for the 25.10.4 -> 25.04.7 mitigation), which would obscure
        // any actual test failure under noise.

        when {
            workflow {
                """
                input[0] = '$projectDir/tests/fixtures/watch_dirs/fastq'   // watch_dir
                input[1] = '**.fastq{,.gz}'                                // file_pattern (matches root + subdir)
                input[2] = 2                                               // batch_size
                input[3] = '30.sec'                                        // batch_interval
                """
            }

            params {
                realtime_mode = true
                batch_timeout = 2
                max_files = 3
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
            // Three fixture files end up in the samples channel regardless
            // of how many batches BatchUtils chunked them into.
            if (workflow.out.samples) {
                def samples = workflow.out.samples.toList()
                assert samples.size() == 3 :
                    "expected 3 sample emissions across both batches, got ${samples.size()}"
            }
        }
    }

    test("Should validate parameters for real-time FASTQ monitoring") {

        tag "hangs-on-jvm-cleanup"

        when {
            workflow {
                """
                input[0] = '$projectDir/tests/fixtures/watch_dirs/fastq'    // watch_dir
                input[1] = '**/*.fastq{,.gz}'              // file_pattern
                input[2] = 3                               // batch_size
                input[3] = '1.min'                         // batch_interval
                """
            }

            params {
                realtime_mode = true
                max_files = "5"
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '2.min'
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out.versions).match()
        }
    }

}
