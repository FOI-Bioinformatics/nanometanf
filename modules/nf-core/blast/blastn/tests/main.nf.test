nextflow_process {

    name "Test Process BLAST_BLASTN"
    script "../main.nf"
    process "BLAST_BLASTN"
    config "./nextflow.config"

    options "-stub"
    tag "fast"
    tag "stub"
    tag "modules"
    tag "modules_nfcore"
    tag "blast"
    tag "blast/blastn"
    tag "blast/makeblastdb"

    test("Should produce blastn output in stub mode") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [ [id:'test'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ]
                input[1] = [ [id:'test2'], file("${outputDir}/blastdb") ]
                input[2] = []
                input[3] = []
                input[4] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt.size() == 1 },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Should produce blastn output for gzipped input in stub mode") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [ [id:'test'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true) ]
                input[1] = [ [id:'test2'], file("${outputDir}/blastdb") ]
                input[2] = []
                input[3] = []
                input[4] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt.size() == 1 },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
