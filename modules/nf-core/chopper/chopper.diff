Changes in component 'nf-core/chopper'
Changes in 'chopper/environment.yml':
--- modules/nf-core/chopper/environment.yml
+++ modules/nf-core/chopper/environment.yml
@@ -5,3 +5,9 @@
   - bioconda
 dependencies:
   - bioconda::chopper=0.12.0b
+  # GNU gzip is required by the script's `gunzip -c | chopper | gzip` pipe.
+  # macOS conda environments otherwise fall back to BSD utilities and the
+  # slim seqera community image for chopper does not bundle GNU coreutils,
+  # so listing gzip explicitly forces both platforms (and any wave-built
+  # container) to include a working gzip/gunzip on PATH.
+  - conda-forge::gzip=1.13

