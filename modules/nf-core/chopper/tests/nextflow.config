// The nanometanf main config (loaded by nf-test alongside this file) sets a
// withName: 'CHOPPER' selector in conf/modules.config that adds a `.chopped`
// suffix to ext.prefix and configures pipeline-level filter args. Match that
// selector strength here so the module test runs in isolation with the
// upstream-expected prefix and an empty args set, independent of pipeline-level
// qc profile defaults. Mirrors the pattern used for FILTLONG in cycle 14.
process {
    withName: 'CHOPPER' {
        ext.args   = ''
        ext.args2  = ''
        ext.args3  = ''
        ext.prefix = { "${meta.id}" }
    }
}
