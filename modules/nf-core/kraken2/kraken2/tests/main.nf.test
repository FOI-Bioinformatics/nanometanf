nextflow_process {
    name "Test Process KRAKEN2_KRAKEN2"
    script "../main.nf"
    process "KRAKEN2_KRAKEN2"

    options "-stub"
    tag "fast"
    tag "stub"
    tag "modules"
    tag "modules_nfcore"
    tag "kraken2"
    tag "kraken2/kraken2"

    test("sarscov2 illumina single end [fastq] - stub") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    [ file(
                        params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz",
                        checkIfExists: true
                    )]
                ]
                input[1] = Channel.of(file("${outputDir}/kraken2_db"))
                input[2] = true
                input[3] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report.size() == 1 },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("sarscov2 illumina paired end [fastq] - stub") {
        when {
            params {
                outdir = "$outputDir"
            }

            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(
                            params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz",
                            checkIfExists: true
                        ),
                        file(
                            params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_2.fastq.gz",
                            checkIfExists: true
                        )
                    ]
                ]
                input[1] = Channel.of(file("${outputDir}/kraken2_db"))
                input[2] = true
                input[3] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report.size() == 1 },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("sarscov2 illumina single end [fastq] + save_reads_assignment - stub") {
        when {
            params {
                outdir = "$outputDir"
            }

            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    [ file(
                        params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz",
                        checkIfExists: true
                    )]
                ]
                input[1] = Channel.of(file("${outputDir}/kraken2_db"))
                input[2] = false
                input[3] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report.size() == 1 },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }
}
