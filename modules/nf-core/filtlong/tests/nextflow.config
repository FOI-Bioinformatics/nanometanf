// The nanometanf main config (loaded by nf-test alongside this file) sets a
// withName: 'FILTLONG' selector in conf/modules.config that overrides any
// blanket process { ext.args / ext.prefix }. Match that selector strength here
// so the module test runs in isolation with deterministic args and prefix,
// independent of pipeline-level qc profile defaults.
process {
    withName: 'FILTLONG' {
        ext.args = "--min_length 10"
        ext.prefix = { "${meta.id}.filtlong" }
    }
}
