nextflow_process {

    name "Test Process REALTIME_PROGRESS_TRACKER"
    script "../main.nf"
    process "REALTIME_PROGRESS_TRACKER"

    options "-stub"

    tag "module"
    tag "realtime_progress_tracker"
    tag "realtime"
    tag "stub"
    tag "fast"

    test("Should emit progress dashboard stub outputs") {

        when {
            process {
                """
                input[0] = [
                    total_detected: 0,
                    ready: 0,
                    not_ready: 0,
                    processed: 0,
                    failed: 0,
                    retries: 0,
                    rate: 0.0,
                    watchdog_status: 'ACTIVE'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.dashboard },
                { assert process.out.stats },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }
}
