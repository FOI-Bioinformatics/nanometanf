nextflow_process {
    name "Test Process KRAKEN2_REPORT_GENERATOR"
    script "../main.nf"
    process "KRAKEN2_REPORT_GENERATOR"

    options "-stub"
    // Test Level & Component
    tag "module"
    tag "kraken2_report_generator"

    // Feature Area
    tag "classification"
    tag "realtime"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    // Test Type
    tag "stub"
    tag "snapshot"

    test("generate report from single batch - stub") {
        when {
            process {
                """
                // Process input: tuple val(meta), path(batch_output), path(batch_report)
                def batch_output = file("sample1_batch0.kraken2.output.txt")
                batch_output.text = "C\\tread1\\t12345\\t100\\t12345:1\\nU\\tread2\\t0\\t100\\t0:100\\n"

                def batch_report = file("sample1_batch0.kraken2.report.txt")
                batch_report.text = '''100.00\\t2\\t0\\tR\\t1\\troot
  50.00\\t1\\t1\\tD\\t12345\\tBacteria
  50.00\\t1\\t1\\tU\\t0\\tunclassified'''

                input[0] = [
                    [ id:'sample1', batch_id: 0 ],
                    batch_output,
                    batch_report
                ]

                // Mock database directory
                input[1] = file(params.modules_testdata_base_path + "genomics/sarscov2/genome/db/kraken2.tar.gz", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report },
                { assert process.out.taxid_counts },
                { assert process.out.stats }
            )
        }
    }

    test("metadata preservation - stub") {
        when {
            process {
                """
                def batch_output = file("special_batch0.kraken2.output.txt")
                batch_output.text = "C\\tread1\\t12345\\t100\\t12345:1\\n"

                def batch_report = file("special_batch0.kraken2.report.txt")
                batch_report.text = "100.00\\t1\\t0\\tR\\t1\\troot"

                input[0] = [
                    [ id:'special_sample', single_end:true, sequencer:'MinION', batch_id: 0 ],
                    batch_output,
                    batch_report
                ]

                input[1] = file(params.modules_testdata_base_path + "genomics/sarscov2/genome/db/kraken2.tar.gz", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report.get(0).get(0).id == 'special_sample' },
                { assert process.out.report.get(0).get(0).single_end == true },
                { assert process.out.report.get(0).get(0).sequencer == 'MinION' }
            )
        }
    }
}
