nextflow_process {

    name "Test Process MINIMAP2_VALIDATION"
    script "../main.nf"
    process "MINIMAP2_VALIDATION"

    tag "module"
    tag "minimap2_validation"
    tag "validation"

    test("Should emit minimap2 validation stub outputs") {

        options "-stub"
        tag "stub"
        tag "fast"

        setup {
            file("${outputDir}").mkdirs()
            file("${outputDir}/sample1_taxid562.fastq.gz").text = ""
            file("${outputDir}/reference.fasta").text = ""
        }

        when {
            process {
                """
                input[0] = [
                    [ id: 'sample1', taxid: 562 ],
                    file("${outputDir}/sample1_taxid562.fastq.gz"),
                    file("${outputDir}/reference.fasta")
                ]
                input[1] = 'map-ont'
                input[2] = 10
                input[3] = 0.5
                input[4] = 90.0
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.alignments },
                { assert process.out.stats },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("real run: breadth from sorted intervals, large PAF survives the sort pipe") {
        // Regression guard for two defects the stub test cannot see, both in
        // the awk stats block (2026-08-18, found on a real Bioshield run):
        //
        // 1. The awk invocation carried the PAF as a trailing FILE argument,
        //    so it read the unsorted file and ignored the `sort -k8,8n` pipe
        //    entirely. The single-pass interval merge assumes ascending
        //    target starts; on out-of-order input it understates breadth.
        //    These reads are deliberately supplied in DESCENDING target
        //    position order, so the unfixed code reports breadth near one
        //    read's span (~0.005) instead of the true ~0.50.
        // 2. With awk not draining the pipe, `sort` took SIGPIPE once the
        //    PAF exceeded the 64 KB pipe buffer, failing the task with exit
        //    141 under pipefail. 1000 alignment rows (~120 KB) trip it;
        //    the tiny fixtures used elsewhere never did.

        tag "real"

        when {
            process {
                """
                input[0] = [
                    [ id: 'bc01', taxid: 9999 ],
                    file("\${projectDir}/modules/local/minimap2_validation/tests/fixtures/reads.fastq"),
                    file("\${projectDir}/modules/local/minimap2_validation/tests/fixtures/reference.fasta")
                ]
                input[1] = 'map-ont'
                input[2] = 10
                input[3] = 0.5
                input[4] = 90.0
                """
            }
        }

        then {
            def stats = new groovy.json.JsonSlurper().parse(file(process.out.stats.get(0).get(1)))
            assertAll(
                { assert process.success },
                { assert stats.total_reads == 1000 },
                // Perfect-match 500 bp substrings: essentially all map.
                { assert stats.mapped_reads >= 950 },
                { assert stats.avg_identity >= 99.0 },
                // Reads tile positions 0..50,450 of a 100 kb reference, so
                // true breadth is ~0.50. The unsorted-merge defect reported
                // ~0.005 here.
                { assert stats.genome_breadth >= 0.45 },
                { assert stats.genome_breadth <= 0.56 },
                { assert stats.ref_length == 100000 },
                // 1000 high-identity reads over half the genome clear every
                // confirmation floor.
                { assert stats.validation_status == 'confirmed' },
            )
        }
    }

    test("real run: breadth is merged per contig and divided by the whole reference") {
        // A two-contig reference: contig_a is 20,000 bp with reads tiling its
        // first 10,000, contig_b is 5,000 bp with reads tiling all of it. True
        // breadth is 15,000 of 25,000 bp, 0.60.
        //
        // The old merge ran over both contigs' intervals at once, so contig_b's
        // positions 0..5,000 counted as already covered by contig_a's, and the
        // result was divided by the longest contig: 10,000 over 20,000, 0.50.
        // Multi-contig references are the normal case for a pathogen genome
        // (chromosome plus plasmids, or a draft in scaffolds) and breadth is a
        // conjunct of "confirmed".

        tag "real"

        when {
            process {
                """
                input[0] = [
                    [ id: 'bc02', taxid: 8888 ],
                    file("\${projectDir}/modules/local/minimap2_validation/tests/fixtures/reads_two_contigs.fastq"),
                    file("\${projectDir}/modules/local/minimap2_validation/tests/fixtures/reference_two_contigs.fasta")
                ]
                input[1] = 'map-ont'
                input[2] = 10
                input[3] = 0.5
                input[4] = 90.0
                """
            }
        }

        then {
            def stats = new groovy.json.JsonSlurper().parse(file(process.out.stats.get(0).get(1)))
            assertAll(
                { assert process.success },
                { assert stats.total_reads == 30 },
                { assert stats.mapped_reads >= 28 },
                // The denominator is the whole reference, both contigs.
                { assert stats.ref_total_length == 25000 },
                // ref_length is still the longest contig (the GUI's plot label).
                { assert stats.ref_length == 20000 },
                // 0.60, give or take the alignment ends. The defect reported
                // 0.50 here, which this lower bound excludes.
                { assert stats.genome_breadth >= 0.55 },
                { assert stats.genome_breadth <= 0.62 },
                { assert stats.covered_bases >= 13500 }
            )
        }
    }
}
