nextflow_process {

    name "Test UPDATE_CUMULATIVE_STATS"
    script "../main.nf"
    process "UPDATE_CUMULATIVE_STATS"

    // Runs the real Python module so the cumulative JSON can be asserted for
    // actual accumulated VALUES across batches (the stub only echoes a marker).
    tag "module"
    tag "update_cumulative_stats"
    tag "realtime"
    tag "fast"
    tag "core"

    test("first batch initialises the cumulative totals") {

        tag "first_batch"

        when {
            process {
                """
                input[0] = [
                    [batch_id: 'batch_001'],
                    [ file('$projectDir/tests/fixtures/snapshots/real_snapshot.json') ]
                ]
                input[1] = [ enable_alerts: true ]
                """
            }
        }

        then {
            assert process.success
            def cum = new groovy.json.JsonSlurper().parse(file(process.out.cumulative_stats.get(0).get(1)))
            assert cum.session_info.total_batches == 1
            assert cum.totals.total_files == 2                  // basic_snapshot file_count
            assert cum.totals.total_size_bytes == 94371840
            assert cum.totals.total_estimated_reads == 18000
            assert cum.totals.total_compressed_files == 2
            assert cum.trends.batch_file_counts == [2]
        }
    }

    test("second batch accumulates over the snapshot series") {

        tag "cumulative_update"

        when {
            process {
                """
                // Both snapshots of the session so far, as BatchSeriesAccumulator
                // hands them on: batch_001 and batch_002 (60 s later), 2 files
                // and 18000 reads each. The module no longer takes a prior
                // cumulative file -- the one it used to read out of its own
                // publish directory, racing the task that wrote it.
                input[0] = [
                    [batch_id: 'batch_002'],
                    [
                        file('$projectDir/tests/fixtures/snapshots/real_snapshot.json'),
                        file('$projectDir/tests/fixtures/snapshots/real_snapshot_batch2.json')
                    ]
                ]
                input[1] = [ enable_trending: true ]
                """
            }
        }

        then {
            assert process.success
            def cum = new groovy.json.JsonSlurper().parse(file(process.out.cumulative_stats.get(0).get(1)))
            assert cum.session_info.total_batches == 2
            assert cum.totals.total_files == 4
            assert cum.totals.total_size_bytes == 188743680
            assert cum.totals.total_estimated_reads == 36000
            assert cum.trends.batch_file_counts.size() == 2
            // Session timing is derived from the series, not from a prior file.
            assert cum.session_info.session_start == 1640995200000
            assert cum.session_info.last_update == 1640995260000
            assert cum.performance.session_duration_seconds == 60.0
        }
    }

    test("snapshot order is by processing time, not by arrival") {

        when {
            process {
                """
                input[0] = [
                    [batch_id: 'batch_001'],
                    [
                        file('$projectDir/tests/fixtures/snapshots/real_snapshot_batch2.json'),
                        file('$projectDir/tests/fixtures/snapshots/real_snapshot.json')
                    ]
                ]
                input[1] = [:]
                """
            }
        }

        then {
            assert process.success
            def cum = new groovy.json.JsonSlurper().parse(file(process.out.cumulative_stats.get(0).get(1)))
            assert cum.session_info.total_batches == 2
            assert cum.session_info.session_start == 1640995200000
            assert cum.trends.batch_timestamps == [1640995200000, 1640995260000]
        }
    }
}
