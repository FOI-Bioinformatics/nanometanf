nextflow_process {

    name "Test Process KRONA_KRAKEN2"
    script "../main.nf"
    process "KRONA_KRAKEN2"

    options "-stub"
    // Test Level & Component
    tag "module"
    tag "krona_kraken2"

    // Feature Area
    tag "classification"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    // Test Type
    tag "stub"
    tag "snapshot"

    test("krona_kraken2 - stub run") {
        when {
            process {
                """
                input[0] = [
                    [id: 'test_sample'],
                    file('$projectDir/tests/fixtures/outputs/classification/kraken2_report.txt')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
