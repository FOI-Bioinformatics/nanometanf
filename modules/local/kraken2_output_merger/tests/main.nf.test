nextflow_process {
    name "Test Process KRAKEN2_OUTPUT_MERGER"
    script "../main.nf"
    process "KRAKEN2_OUTPUT_MERGER"

    options "-stub"
    // Test Level & Component
    tag "module"
    tag "kraken2_output_merger"

    // Feature Area
    tag "classification"
    tag "realtime"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    // Test Type
    tag "stub"
    tag "snapshot"

    test("merge single batch - stub") {
        when {
            process {
                """
                // Process input: tuple val(meta), path(kraken2_output), path(batch_metadata), path(batch_report)
                def batch_output = file("test_batch0.kraken2.output.txt")
                batch_output.text = "C\\tread1\\t12345\\t100\\t12345:1\\nU\\tread2\\t0\\t100\\t0:100\\n"

                def metadata = file("batch_metadata.json")
                metadata.text = '{"sample_id": "sample1", "batch_id": 0, "kraken2_output": "test_batch0.kraken2.output.txt"}'

                def batch_report = file("test_batch0.kraken2.report.txt")
                batch_report.text = "100.00\\t2\\t0\\tR\\t1\\troot"

                input[0] = [
                    [ id:'sample1', batch_id: 0 ],
                    batch_output,
                    metadata,
                    batch_report
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.batch_output },
                { assert process.out.merger_output },
                { assert process.out.stats }
            )
        }
    }

    test("metadata preservation - stub") {
        when {
            process {
                """
                def batch_output = file("special_batch0.kraken2.output.txt")
                batch_output.text = "C\\tread1\\t12345\\t100\\t12345:1\\n"

                def metadata = file("batch_metadata.json")
                metadata.text = '{"sample_id": "special_sample", "batch_id": 0}'

                def batch_report = file("special_batch0.kraken2.report.txt")
                batch_report.text = "100.00\\t1\\t0\\tR\\t1\\troot"

                input[0] = [
                    [ id:'special_sample', single_end:true, run_id:'RUN001', batch_id: 0 ],
                    batch_output,
                    metadata,
                    batch_report
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.merger_output.get(0).get(0).id == 'special_sample' },
                { assert process.out.merger_output.get(0).get(0).single_end == true },
                { assert process.out.merger_output.get(0).get(0).run_id == 'RUN001' }
            )
        }
    }
}
