nextflow_process {

    name "Test Process MANIFEST_WRITER"
    script "../main.nf"
    process "MANIFEST_WRITER"

    options "-stub"

    tag "module"
    tag "manifest_writer"
    tag "canonical"
    tag "stub"
    tag "fast"

    test("Should emit canonical manifest stub outputs") {

        when {
            process {
                """
                input[0] = 'kraken2'
                input[1] = 'fastp'
                input[2] = ''
                input[3] = ''
                input[4] = [ 'sample1', 'sample2' ]
                input[5] = [ 'sample1', 'sample2' ]
                input[6] = []
                input[7] = 'batch'
                input[8] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.manifest },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }
}
