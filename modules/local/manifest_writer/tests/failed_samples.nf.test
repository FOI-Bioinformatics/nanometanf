nextflow_process {

    name "Test MANIFEST_WRITER failed-sample recording"
    script "../main.nf"
    process "MANIFEST_WRITER"

    tag "module"
    tag "manifest_writer"
    tag "fast"
    tag "core"

    // Deliberately NOT `options "-stub"`, unlike the sibling main.nf.test.
    // These assert the real script's logic; the stub emits a hardcoded
    // {"samples":[]} and would make them pass or fail for unrelated reasons.
    //
    // A sample that entered the pipeline but produced no QC output was listed
    // in the manifest exactly like a healthy one. The manifest cannot discover
    // files -- MANIFEST_WRITER runs in its own work directory, not the
    // publishDir -- so it takes the produced set as an input and records the
    // difference. nanometa_live reads this manifest for its sample list, and an
    // empty view of a sample that never ran reads as "nothing detected".

    test("records samples that produced no output as failed_samples") {
        when {
            process {
                """
                input[0] = 'kraken2'
                input[1] = 'chopper'
                input[2] = ''
                input[3] = ''
                input[4] = [ 'healthy', 'failed_qc' ]
                input[5] = [ 'healthy' ]
                input[6] = []
                input[7] = 'batch'
                input[8] = true
                """
            }
        }
        then {
            assert process.success
            def manifest = path("${process.out.manifest[0]}").json
            assert manifest.samples.contains('failed_qc') :
                "the attempted sample must still be listed; dropping it loses " +
                "the fact that the barcode was tried at all"
            assert manifest.failed_samples == ['failed_qc'] :
                "the sample that produced no output is not recorded: ${manifest.failed_samples}"
        }
    }

    test("failed_samples is null when the produced set was not supplied") {
        // null means "not determined"; [] would mean "none failed". Claiming
        // the latter without evidence is the false reassurance this prevents.
        //
        // "Not supplied" is '', NOT []. This test passed [] until 2026-08-09,
        // which is the value the workflow sends when it HAS determined the
        // answer and the answer is "none produced" -- see the all-fail test
        // below. Overloading one value with both meanings is what let that
        // case be reported as "not determined".
        //
        // '' rather than null because Nextflow refuses null for a val input
        // ("A process input channel evaluates to null -- Invalid declaration
        // `val produced_sample_ids`"), so a List -- empty or not -- is the
        // determined case and a non-List is the undetermined one.
        when {
            process {
                """
                input[0] = 'kraken2'
                input[1] = 'chopper'
                input[2] = ''
                input[3] = ''
                input[4] = [ 'healthy', 'other' ]
                input[5] = ''
                input[6] = []
                input[7] = 'batch'
                input[8] = true
                """
            }
        }
        then {
            assert process.success
            def manifest = path("${process.out.manifest[0]}").json
            assert manifest.failed_samples == null :
                "an unsupplied produced-set reported as 'none failed': ${manifest.failed_samples}"
        }
    }

    test("every sample failing names them all, rather than reporting null") {
        // The case this whole field exists for, and the one it got wrong.
        //
        // workflows/nanometanf.nf:522 ends ch_produced_sample_ids with
        // .ifEmpty([]), so when no sample emits QC output the module receives
        // an empty list -- a determined answer, not a missing one. The module
        // then dropped the --produced-samples flag because the joined string
        // was falsy, and write_manifest.py saw a flag it had never been given.
        //
        // Reproduced on a real run: a single corrupt FASTQ, CHOPPER exit 1
        // absorbed by conf/error_isolation.config, and the emitted manifest
        // carried "failed_samples": null while claiming the sample's
        // qc_stats.json was available. No such file existed anywhere in the
        // outdir. nanometa_live reads this manifest for its sample list, so
        // the barcode rendered like a healthy one.
        when {
            process {
                """
                input[0] = 'kraken2'
                input[1] = 'chopper'
                input[2] = ''
                input[3] = ''
                input[4] = [ 'corrupt_one', 'corrupt_two' ]
                input[5] = []
                input[6] = []
                input[7] = 'batch'
                input[8] = true
                """
            }
        }
        then {
            assert process.success
            def manifest = path("${process.out.manifest[0]}").json
            assert manifest.failed_samples == [ 'corrupt_one', 'corrupt_two' ] :
                "a batch in which every sample failed QC reported " +
                "${manifest.failed_samples} instead of naming them; null here " +
                "reads as 'not determined' and hides a total QC failure"
            assert manifest.samples.contains('corrupt_one') :
                "the attempted samples must still be listed; dropping them " +
                "loses the fact that the barcodes were tried at all"
        }
    }

    test("all samples producing output yields an empty failed list") {
        when {
            process {
                """
                input[0] = 'kraken2'
                input[1] = 'chopper'
                input[2] = ''
                input[3] = ''
                input[4] = [ 'a', 'b' ]
                input[5] = [ 'a', 'b' ]
                input[6] = []
                input[7] = 'batch'
                input[8] = true
                """
            }
        }
        then {
            assert process.success
            def manifest = path("${process.out.manifest[0]}").json
            assert manifest.failed_samples == [] :
                "a healthy run should record an empty failed list, not null: ${manifest.failed_samples}"
        }
    }

    test("assembly files are reported as produced, not derived from the sample list") {
        // The manifest used to build "<sample>.assembly_stats.json" for every
        // sample whenever an assembler was set, so a run whose assemblies all
        // failed still asserted a file per sample -- files no consumer could
        // open (nanometa_live assembly audit, 2026-09-03).
        when {
            process {
                """
                input[0] = 'kraken2'
                input[1] = 'chopper'
                input[2] = 'flye'
                input[3] = ''
                input[4] = [ 'assembled', 'not_assembled' ]
                input[5] = [ 'assembled', 'not_assembled' ]
                input[6] = [ 'assembled.assembly_stats.json' ]
                input[7] = 'batch'
                input[8] = true
                """
            }
        }
        then {
            assert process.success
            def manifest = new groovy.json.JsonSlurper().parseText(
                path(process.out.manifest[0]).text)
            assert manifest.outputs.assembly.available == true
            assert manifest.outputs.assembly.files == [ 'assembled.assembly_stats.json' ]
            assert !manifest.outputs.assembly.files.contains('not_assembled.assembly_stats.json')
        }
    }

    test("an assembler with no surviving output reports none available") {
        when {
            process {
                """
                input[0] = 'kraken2'
                input[1] = 'chopper'
                input[2] = 'flye'
                input[3] = ''
                input[4] = [ 'sample1', 'sample2' ]
                input[5] = [ 'sample1', 'sample2' ]
                input[6] = []
                input[7] = 'batch'
                input[8] = true
                """
            }
        }
        then {
            assert process.success
            def manifest = new groovy.json.JsonSlurper().parseText(
                path(process.out.manifest[0]).text)
            assert manifest.outputs.assembly.available == false
            assert manifest.outputs.assembly.files == []
            // The assembler is still recorded: it ran and produced nothing,
            // which is different from never having been asked to.
            assert manifest.tools.assembler == 'flye'
        }
    }

}
