nextflow_process {

    name "Test Process NANOPLOT_COMPARE"
    script "../main.nf"
    process "NANOPLOT_COMPARE"

    options "-stub"
    // Test Level & Component
    tag "module"
    tag "nanoplot_compare"

    // Feature Area
    tag "qc"

    // Execution Speed & Criticality
    tag "medium"
    tag "core"

    // Test Type
    tag "stub"
    tag "snapshot"

    test("nanoplot_compare - stub run") {
        when {
            process {
                """
                input[0] = []
                input[1] = 'test_comparison'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
