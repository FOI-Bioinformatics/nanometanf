nextflow_process {

    name "Test DORADO_DEMUX process"
    script "../main.nf"
    process "DORADO_DEMUX"

    options "-stub"
    // Test Level & Component
    tag "module"
    tag "dorado_demux"

    // Feature Area
    tag "barcode_discovery"
    tag "basecalling"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    test("Should demultiplex FASTQ with Dorado") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_sample', barcode_kit: 'SQK-NBD114-24' ],
                    file('$projectDir/tests/test_sample.fastq.gz')
                ]
                input[1] = 'SQK-NBD114-24'
                """
            }
        }

        then {
            // In stub mode, should always succeed
            assert process.success
            // Check outputs exist (demuxed_reads is optional in the module)
            assert process.out.versions
            assert process.out.versions.size() == 1
        }
    }

    test("Should create stub outputs") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'stub_test', barcode_kit: 'SQK-NBD114-24' ],
                    file('$projectDir/tests/test_sample.fastq.gz')
                ]
                input[1] = 'SQK-NBD114-24'
                """
            }
        }

        then {
            // In stub mode, should always succeed
            assert process.success
            assert process.out.versions
            assert process.out.versions.size() == 1
        }
    }
}
