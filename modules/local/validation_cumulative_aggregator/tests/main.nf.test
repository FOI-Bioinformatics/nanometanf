nextflow_process {

    name "Test VALIDATION_CUMULATIVE_AGGREGATOR"
    script "../main.nf"
    process "VALIDATION_CUMULATIVE_AGGREGATOR"

    tag "modules"
    tag "modules_local"
    tag "validation"
    tag "realtime"
    tag "cumulative"
    tag "fast"

    // Fixtures use the REAL per-(sample,taxid) names: every batch file for a
    // pair is <prefix>.paf, which is also the cumulative output name. Passing
    // two of them in one list is the point -- it exercises the indexed stageAs
    // that keeps same-named batch files from colliding in the work directory,
    // and keeps them out of the output matching set.
    test("minimap2 cumulative - single batch") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], "2697049",
                    [ file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/batch/test_taxid2697049.paf", checkIfExists: true) ],
                    [ file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/batch/test_taxid2697049.minimap2_stats.json", checkIfExists: true) ]
                ]
                input[1] = 'minimap2'
                """
            }
        }
        then {
            def stats = new groovy.json.JsonSlurper().parseText(file(process.out.stats.get(0).get(2)).text)
            assertAll(
                { assert process.success },
                { assert stats.total_reads == 3 },      // this batch only
                { assert stats.mapped_reads == 2 },
                { assert stats.validation_method == 'minimap2' },
                // versions.yml must be valid YAML: top key at column 0 (no
                // leading whitespace), else version collation fails the pipeline.
                { assert file(process.out.versions.get(0)).readLines()[0].startsWith('"') },
                { assert path(process.out.minimap2_cumulative.get(0).get(2)).readLines().size() == 2 }
            )
        }
    }

    test("minimap2 cumulative - two batches accumulate") {
        when {
            process {
                """
                // Two batches of the same (sample, taxid), both named
                // test_taxid2697049.paf: r1,r2 (total_reads=2) and r3,r4
                // (total_reads=3). Expect total_reads 5, mapped 4 (dedup),
                // hit_rate 0.8 -- the same figures the prior+batch form gave,
                // now derived from the batch set rather than from a file read
                // out of the publish directory.
                input[0] = [
                    [ id:'test', single_end:true ], "2697049",
                    [
                        file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/prior/test_taxid2697049.paf", checkIfExists: true),
                        file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/batch/test_taxid2697049.paf", checkIfExists: true)
                    ],
                    [
                        file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/prior/test_taxid2697049.minimap2_stats.json", checkIfExists: true),
                        file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/batch/test_taxid2697049.minimap2_stats.json", checkIfExists: true)
                    ]
                ]
                input[1] = 'minimap2'
                """
            }
        }
        then {
            def stats = new groovy.json.JsonSlurper().parseText(file(process.out.stats.get(0).get(2)).text)
            assertAll(
                { assert process.success },
                { assert stats.total_reads == 5 },
                { assert stats.mapped_reads == 4 },
                { assert stats.hit_rate == 0.8 },
                { assert stats.avg_coverage >= 0.0 && stats.avg_coverage <= 1.0 },
                { assert stats.containsKey('avg_mapq') },
                { assert stats.containsKey('avg_identity') },
                { assert stats.containsKey('ref_name') },
                // Confirmation floors (cross-repo contract): 4 mapped reads
                // at high hit rate and identity are NOT a confirmation --
                // the pre-floor code wrote 'confirmed' here, which is how a
                // single index-hopped read in a negative control shipped as
                // a confirmed Tier 1 select agent in realtime mode
                // (2026-08-18 realtime audit).
                { assert stats.validation_status == 'uncertain' },
                // Real genome breadth must ride the cumulative stats; the
                // GUI and the exported artifact read it from here.
                { assert stats.containsKey('genome_breadth') },
                { assert path(process.out.minimap2_cumulative.get(0).get(2)).readLines().size() == 4 }
            )
        }
    }

    test("blast cumulative - two batches accumulate") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], "2697049",
                    [
                        file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/prior/test_taxid2697049.blast.tsv", checkIfExists: true),
                        file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/batch/test_taxid2697049.blast.tsv", checkIfExists: true)
                    ],
                    [
                        file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/prior/test_taxid2697049.blast_stats.json", checkIfExists: true),
                        file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/batch/test_taxid2697049.blast_stats.json", checkIfExists: true)
                    ]
                ]
                input[1] = 'blast'
                """
            }
        }
        then {
            def stats = new groovy.json.JsonSlurper().parseText(file(process.out.stats.get(0).get(2)).text)
            assertAll(
                { assert process.success },
                { assert stats.total_reads == 5 },
                { assert stats.blast_hits == 4 },
                { assert stats.hit_rate == 0.8 },
                { assert stats.avg_coverage >= 0.0 && stats.avg_coverage <= 1.0 },
                { assert stats.validation_method == 'blast' },
                { assert stats.containsKey('avg_identity') },
                { assert stats.containsKey('min_evalue') },
                // min_reads floor (cross-repo contract): 4 hits cannot
                // confirm, mirroring BLASTN_VALIDATION.
                { assert stats.validation_status == 'uncertain' },
                { assert path(process.out.blast_cumulative.get(0).get(2)).readLines().size() == 4 }
            )
        }
    }

    test("minimap2 cumulative - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], "2697049",
                    [ file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/batch/test_taxid2697049.paf", checkIfExists: true) ],
                    [ file("\${projectDir}/modules/local/validation_cumulative_aggregator/tests/fixtures/batch/test_taxid2697049.minimap2_stats.json", checkIfExists: true) ]
                ]
                input[1] = 'minimap2'
                """
            }
        }
        then {
            assertAll( { assert process.success } )
        }
    }
}
