config {

    testsDir "."
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    // Recommended toolchain for this repository (cycle 3, 2026-04-25):
    //   nf-test 0.9.4   -- closure-based input dispatch + setup blocks
    //   Nextflow 25.10  -- run with NXF_OFFLINE=true to avoid the
    //                       String.format plugin-loader regression
    // The 0.9.x line is required because
    // modules/local/seqkit_merge_stats/tests/main.nf.test relies on the
    // setup{} block syntax introduced in 0.9. nf-test does not expose a
    // version pin in the config file, so the pin lives in CI workflows
    // and in the developer guide.
    //
    // Realtime workaround (Task #26, 2026-04-26): Nextflow 25.10.4 does
    // not release the DirWatcherV2 / FileAlterationMonitor thread after
    // a realtime_timeout sentinel fires, so any nf-test that exercises
    // realtime_mode=true hangs after the run completes. nf-test 0.9.4
    // exposes only a minimum-version `requires` block (no exact pin),
    // so realtime_mode tests must be invoked with NXF_VER=25.04.7 to
    // pick up the Nextflow release whose post-timeout shutdown path
    // completes cleanly:
    //   NXF_VER=25.04.7 NXF_OFFLINE=true \
    //       nf-test test subworkflows/local/realtime_monitoring/...
    // Non-realtime tests can stay on the default 25.10.4.
    //
    // tests/nextflow.config gates container engines per profile. An empty
    // profile here lets each invocation choose conda/docker/etc
    // explicitly via the --profile flag.
    profile ""

}
