config {

    testsDir "."
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    // Recommended toolchain for this repository (cycle 3, 2026-04-25):
    //   nf-test 0.9.4   -- closure-based input dispatch + setup blocks
    //   Nextflow 25.10  -- run with NXF_OFFLINE=true to avoid the
    //                       String.format plugin-loader regression
    // The 0.9.x line is required because
    // modules/local/seqkit_merge_stats/tests/main.nf.test relies on the
    // setup{} block syntax introduced in 0.9. nf-test does not expose a
    // version pin in the config file, so the pin lives in CI workflows
    // and in the developer guide.
    //
    // Realtime workaround (Task #26, cycle 6 / 2026-04-27): Nextflow
    // 25.10.4 does not release the DirWatcherV2 / FileAlterationMonitor
    // thread after a realtime_timeout sentinel fires, so any nf-test
    // that exercises realtime_mode=true hangs after the run completes.
    // nf-test 0.9.4 exposes only a minimum-version `requires` block
    // (no exact pin), so the runtime version has to be selected via
    // the NXF_VER environment variable. The repository ships a thin
    // wrapper that sets NXF_VER=25.04.7 and NXF_OFFLINE=true:
    //   bin/run-nf-tests.sh test \
    //       subworkflows/local/realtime_monitoring/tests/main.nf.test
    // The same pin is mirrored in .github/workflows/nf-test.yml.
    //
    // Cycle 6 verification recorded a partial outcome: 25.04.7
    // releases the FileAlterationMonitor cleanly when the realtime
    // timeout sentinel fires (Scenarios B/C/D in the audit harness),
    // but not when the watchPath channel completes via .take()
    // before any timeout fires. The task10 regression test
    // (max_files=1, 1 file present) still hangs the JVM under
    // 25.04.7 -- jstack confirms the same Apache commons-io
    // FileAlterationMonitor.run non-daemon thread is responsible.
    // Task #26 therefore stays open for the upstream fix; the
    // wrapper is still the recommended single entry point because
    // it keeps the toolchain pin centralised and remains harmless
    // for the non-realtime tests that make up the bulk of the suite.
    //
    // tests/nextflow.config gates container engines per profile. An empty
    // profile here lets each invocation choose conda/docker/etc
    // explicitly via the --profile flag.
    profile ""

}
