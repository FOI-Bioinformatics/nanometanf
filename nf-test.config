config {

    testsDir "."
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    // Recommended toolchain for this repository:
    //   nf-test 0.9.5       -- closure-based input dispatch + setup blocks
    //   Nextflow >= 26.04.0 -- floor pinned in nextflow.config; the
    //                          realtime watchPath JVM cleanup hang
    //                          (task #26) no longer reproduces.
    //
    // The pipeline parses cleanly under the strict v2 grammar (default
    // in Nextflow 26+); no NXF_SYNTAX_PARSER opt-in is needed.
    //
    // tests/nextflow.config gates container engines per profile. An empty
    // profile here lets each invocation choose conda/docker/etc
    // explicitly via the --profile flag.
    profile ""

    // nft-utils plugin (cycle 15, 2026-04-27): provides the
    // sanitizeOutput() helper used by the upstream nf-core multiqc,
    // taxpasta/merge, and fastqc nf-tests. The helper is not part of
    // nf-test core; it ships with the nft-utils plugin
    // (nf-core/nft-utils, OutputSanitizer.java added in 0.0.7).
    // Without this plugin block the affected tests fail with
    // groovy.lang.MissingMethodException on ProcessContext.
    // Pinned to 0.0.8 (latest non-dev release; 0.0.9 is dev as of
    // 2026-04-27). nft-utils plugin downloads are managed by the
    // nf-test plugin loader and are independent of NXF_OFFLINE.
    plugins {
        load "nft-utils@0.0.8"
    }

}
