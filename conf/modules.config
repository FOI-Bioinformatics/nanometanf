/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------

    publishDir convention (2026-03-14 standardization):
        - QC tools:        {tool}/           (fastp/, chopper/, nanoplot/, seqkit/)
        - Classification:  kraken2/          (flat for reports, per-sample subdirs for batches)
        - Validation:      validation/{tool}/ (validation/blast/, validation/minimap2/)
        - Reports:         multiqc/
        - Assembly:        {tool}/           (flye/, miniasm/)

    Frontend-critical paths (Nanometa Live hardcodes these):
        - kraken2/                              -> data_loaders.py, sample_detector.py
        - kraken2/{sample}/batch_reports/        -> data_loaders.py (incremental mode)
        - fastp/                                 -> data_loaders.py
        - nanoplot/{sample}/                     -> data_loaders.py
        - seqkit/                                -> data_loaders.py
        - validation/blast/                      -> blast_validation_parser.py, data_loaders.py
        - validation/minimap2/                   -> validation_tab.py
        - validation/validation_results.json     -> data_loaders.py
        - multiqc/                               -> implied by dashboard

    Path changes applied 2026-03-14:
        - SEQKIT_MERGE_STATS: qc/{sample}/stats -> seqkit/{sample}/stats (align with tool-name convention)
        - SEQKIT_MERGE_STATS: qc/{sample}/manifests -> seqkit/{sample}/manifests (align with tool-name convention)
        - Added explicit publishDir for FASTP_STREAMING (was relying on default tokenizer)
        - Added explicit publishDir for NANOPLOT (was relying on default tokenizer)
        - Added section headers for organizational clarity
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // QC Modules
    // Outputs: {tool}/ - tool-name convention for Nanometa Live compatibility
    //

    withName: FASTQC {
        // --dir . forces FastQC to unzip gzipped FASTQ into the task
        // workDir rather than $TMPDIR (defaults to /tmp). Long
        // nanopore FASTQs commonly exceed node-local /tmp; without
        // this flag FastQC fails with 'No space left on device' on
        // shared HPC nodes.
        ext.args = '--quiet --dir .'
        ext.prefix = { "${meta.id}" }
        // Reduce memory for development/testing
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
    }

    withName: SEQKIT_STATS {
        ext.prefix = { "${meta.id}" }
        // In incremental mode, per-batch SEQKIT_STATS would overwrite the
        // canonical seqkit/{sample}.tsv on each batch (the default tokenizer
        // publishDir uses a fixed filename), leaving the published file as
        // the last batch only. Park per-batch outputs under a sample-scoped
        // batch_stats/ directory so SEQKIT_MERGE_STATS still consumes them
        // via channel staging while the canonical flat path is filled by
        // the merged cumulative file written by SEQKIT_MERGE_STATS. In
        // non-incremental mode the legacy flat publish (one batch, one
        // sample) remains correct, so both publish entries are gated on
        // mutually exclusive enabled expressions.
        //
        // The auto-promotion (realtime_mode + kraken2_enable_incremental)
        // mirrors the auto-promotion in QC_ANALYSIS so the publish layout
        // tracks the in-workflow aggregation decision exactly.
        publishDir = [
            [
                path: { "${params.outdir}/seqkit/${meta.id}/batch_stats" },
                mode: params.publish_dir_mode,
                enabled: (params.qc_enable_incremental ?: false) || ((params.realtime_mode ?: false) && (params.kraken2_enable_incremental ?: false)),
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    // Disambiguate per-batch filenames using batch_time
                    // (set by REALTIME_MONITORING). Fall back to a hash of
                    // the work directory when no timestamp is available so
                    // the per-batch files never collide.
                    def stamp = meta.batch_time ?: meta.batch_id ?: "batch_${task.hash}"
                    return "${meta.id}.${stamp}.tsv"
                }
            ],
            [
                path: { "${params.outdir}/seqkit" },
                mode: params.publish_dir_mode,
                enabled: !((params.qc_enable_incremental ?: false) || ((params.realtime_mode ?: false) && (params.kraken2_enable_incremental ?: false))),
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: 'FASTP_STREAMING' {
        // Explicit publishDir to ensure frontend-compatible path (fastp/)
        // Default tokenizer produces correct result, but explicit is safer
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHOPPER' {
        ext.args2 = [
            params.chopper_quality ? "--quality ${params.chopper_quality}" : '',
            params.chopper_minlength ? "--minlength ${params.chopper_minlength}" : '',
            params.chopper_maxlength ? "--maxlength ${params.chopper_maxlength}" : '',
            params.chopper_headcrop ? "--headcrop ${params.chopper_headcrop}" : '',
            params.chopper_tailcrop ? "--tailcrop ${params.chopper_tailcrop}" : ''
        ].join(' ').trim()
        ext.prefix = { "${meta.id}.chopped" }
        // Reduce memory for development/testing (default is 36 GB from process_medium)
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
        // Standardized output naming for Nanometa Live integration
        publishDir = [
            path: { "${params.outdir}/chopper" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTLONG' {
        // Interpolate filtlong threshold parameters into the command line.
        // The upstream nf-core FILTLONG module reads task.ext.args, so without
        // this block none of the filtlong_* parameters reach the binary, and
        // filtlong aborts with "Error: no thresholds set". At least one of
        // min_length, keep_percent, target_bases, min_mean_q, or min_window_q
        // must be supplied; the QC profiles in conf/qc_profiles.config set
        // sensible defaults per scenario.
        ext.args = [
            params.filtlong_min_length    ? "--min_length ${params.filtlong_min_length}"     : '',
            params.filtlong_max_length    ? "--max_length ${params.filtlong_max_length}"     : '',
            params.filtlong_keep_percent  ? "--keep_percent ${params.filtlong_keep_percent}" : '',
            params.filtlong_target_bases  ? "--target_bases ${params.filtlong_target_bases}" : '',
            params.filtlong_min_mean_q    ? "--min_mean_q ${params.filtlong_min_mean_q}"     : '',
            params.filtlong_min_window_q  ? "--min_window_q ${params.filtlong_min_window_q}" : ''
        ].join(' ').trim()
        ext.prefix = { "${meta.id}.filtlong" }
        // Standardized output naming for Nanometa Live integration
        publishDir = [
            path: { "${params.outdir}/filtlong" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Reporting Modules
    //

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Classification Modules
    // Outputs: kraken2/ - flat for cumulative reports, per-sample subdirs for batch data
    //
    // max_classification_forks tuning guide:
    //   With --kraken2_memory_mapping (mmap): forks share OS page cache, set based on CPU count
    //   Without --kraken2_memory_mapping: each fork loads full DB, set based on available_memory / db_size
    //   Default 4 is conservative; increase for high-memory systems
    //

    withName: 'KRAKEN2_KRAKEN2' {
        // Memory request scales from ``params.kraken2_memory_gb``
        // (default 12 GB, sized for MiniKraken2). Operators running
        // GTDB Bac120 (~25 GB), PlusPF (~70 GB), or PlusPFP (~80 GB)
        // MUST raise this -- "DB size + 4 GB" is a safe rule of thumb.
        // With ``--kraken2_memory_mapping`` (default true) all forks
        // share the OS page cache, so this is the per-process headroom
        // not a per-instance copy.
        memory = { (params.kraken2_memory_gb ?: 12).GB * task.attempt }
        // CPU allocation scales with params.max_classification_forks so
        // single-sample runs use the full CPU budget (8+ CPUs) while
        // multi-sample runs share it (e.g. 4 forks * 4 CPUs = 16 CPUs).
        // Floor of 4 keeps Kraken2 throughput acceptable.
        cpus = { Math.max(4, ((params.max_cpus ?: 16) as int).intdiv(Math.max(1, (params.max_classification_forks ?: 1) as int))) }
        // --memory-mapping segfaults on certain shared filesystems
        // (NFS, GlusterFS, CIFS, FUSE) because mmap'd pages of
        // hash.k2d return invalid data once the kraken2 process
        // touches them. The retry path drops --memory-mapping and
        // reads the DB into per-process RAM instead. errorStrategy +
        // maxRetries wires up the automatic retry on exit 139 (SIGSEGV).
        ext.args = { (params.kraken2_memory_mapping && task.attempt == 1) ? "--memory-mapping" : "" }
        errorStrategy = { task.exitStatus == 139 && task.attempt == 1 ? 'retry' : 'finish' }
        maxRetries = 1
        // Standardized output naming for Nanometa Live integration
        publishDir = [
            [
                path: { "${params.outdir}/kraken2" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    if (filename.endsWith('.report.txt')) return "${meta.id}.kraken2.report.txt"
                    if (filename.endsWith('.classified.fastq.gz')) return "${meta.id}.kraken2.classified.fastq.gz"
                    if (filename.endsWith('.unclassified.fastq.gz')) return "${meta.id}.kraken2.unclassified.fastq.gz"
                    return filename
                }
            ],
            [
                // Per-read classification output for on-demand validation in Nanometa Live
                path: { "${params.outdir}/kraken2" },
                mode: params.publish_dir_mode,
                pattern: "*classifiedreads.txt",
                enabled: params.save_reads_assignment,
                saveAs: { filename -> "${meta.id}.kraken2.output.txt" }
            ]
        ]
    }

    withName: 'KRAKEN2_DB_PRELOAD' {
        // KRAKEN2_DB_PRELOAD warms the OS page cache for the Kraken2
        // hash file so downstream parallel classification forks share
        // the cached pages instead of each re-reading independently.
        // Its `output: path db, emit: db` line in modules/local/
        // kraken2_db_preload/main.nf is a passthrough for channel
        // wiring (downstream classifiers chain off ch_db_ready), not
        // a real output -- but without an explicit publishDir
        // override, the default rule at the top of this file
        // (mode: copy, no pattern filter) copies the entire database
        // directory (10-100 GB) into ${params.outdir}/kraken2/
        // on every run, blocking the pipeline on SAN write throughput
        // and producing the symptom "no reports appear in kraken2/
        // for many minutes". The pattern filter below restricts
        // publication to versions.yml; the db directory and any other
        // process output is dropped.
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: "versions.yml"
        ]
    }

    // Placeholder Kraken2 reports for samples whose post-QC FASTQ is
    // empty (every read filtered upstream). Publishes to the same
    // path as KRAKEN2_KRAKEN2.out.report so the Nanometa Live GUI
    // sees the sample with a 0-read accounting instead of nothing.
    withName: 'EMIT_EMPTY_KRAKEN2_REPORT' {
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename
            }
        ]
    }

    withName: 'KRAKEN2_INCREMENTAL_CLASSIFIER' {
        // Incremental classification with batch caching (PromethION optimization).
        // Same resource scaling as KRAKEN2_KRAKEN2: memory follows
        // ``params.kraken2_memory_gb`` so PlusPFP-class databases get
        // their headroom and MiniKraken2 dev runs stay light.
        // SCALABLE STREAMING: maxForks controlled by max_classification_forks parameter.
        memory = { (params.kraken2_memory_gb ?: 12).GB * task.attempt }
        // CPUs scale with max_classification_forks (see KRAKEN2_KRAKEN2 above).
        cpus = { Math.max(4, ((params.max_cpus ?: 16) as int).intdiv(Math.max(1, (params.max_classification_forks ?: 1) as int))) }
        maxForks = params.max_classification_forks ?: 4
        // Auto-retry on SIGSEGV (exit 139) without --memory-mapping.
        // See the matching withName block for KRAKEN2_KRAKEN2 above.
        errorStrategy = { task.exitStatus == 139 && task.attempt == 1 ? 'retry' : 'finish' }
        maxRetries = 1
        // Removed fair=true: FIFO scheduling keeps same-sample batches together,
        // improving OS page cache hit rate for the Kraken2 database
        publishDir = [
            [
                path: { "${params.outdir}/kraken2/${meta.id}/reports" },
                mode: params.publish_dir_mode,
                pattern: "*.report.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: 'KRAKEN2_OPTIMIZED' {
        // Phase 4.1 batch processor; uses memory-mapping and confidence
        // filters. Shares the mmap-segfault retry path with
        // KRAKEN2_KRAKEN2 and KRAKEN2_INCREMENTAL_CLASSIFIER -- see
        // those blocks above for context.
        memory = { (params.kraken2_memory_gb ?: 12).GB * task.attempt }
        // CPUs scale with max_classification_forks (see KRAKEN2_KRAKEN2 above).
        cpus = { Math.max(4, ((params.max_cpus ?: 16) as int).intdiv(Math.max(1, (params.max_classification_forks ?: 1) as int))) }
        errorStrategy = { task.exitStatus == 139 && task.attempt == 1 ? 'retry' : 'finish' }
        maxRetries = 1
    }

    withName: 'KRAKEN2_OUTPUT_MERGER' {
        // SCALABLE STREAMING: Stateless batch file storage
        // Per-sample parallelism with bounded concurrency
        memory = { 4.GB * task.attempt }
        cpus = 2
        maxForks = params.max_classification_forks ?: 4  // Match classifier forks (lightweight but no need for 2x)
        publishDir = [
            [
                // Per-sample batch output files
                path: { "${params.outdir}/kraken2/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "batches/*",
                enabled: params.kraken2_enable_incremental,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Per-sample batch report files
                path: { "${params.outdir}/kraken2/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "batch_reports/*",
                enabled: params.kraken2_enable_incremental,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Merge statistics
                path: { "${params.outdir}/kraken2/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "merge_stats.json",
                enabled: params.kraken2_enable_incremental
            ]
        ]
    }

    withName: 'KRAKEN2_REPORT_GENERATOR' {
        // SCALABLE STREAMING: Stateless per-batch report processing
        // Bounded concurrency to prevent memory exhaustion
        memory = { 1.GB * task.attempt }
        cpus = 1
        maxForks = params.max_classification_forks ?: 4  // Match classifier forks (lightweight but no need for 2x)
        publishDir = [
            [
                // Per-batch report with standardized naming
                path: { "${params.outdir}/kraken2/${meta.id}/batch_reports" },
                mode: params.publish_dir_mode,
                pattern: "*_batch*.kraken2.report.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Per-batch taxid counts
                path: { "${params.outdir}/kraken2/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "batch_taxid_counts.json",
                saveAs: { filename -> "batch_${meta.batch_id}_taxid_counts.json" }
            ],
            [
                // Report statistics
                path: { "${params.outdir}/kraken2/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "report_stats.json",
                saveAs: { filename -> "batch_${meta.batch_id}_report_stats.json" }
            ]
        ]
    }

    withName: 'KRAKEN2_FINAL_AGGREGATOR' {
        // End-of-session aggregation: concatenates batch files into cumulative outputs
        // Runs once per sample at end of real-time session
        memory = { 8.GB * task.attempt }
        cpus = 2
        publishDir = [
            [
                // Final cumulative output for downstream tools
                path: { "${params.outdir}/kraken2" },
                mode: params.publish_dir_mode,
                pattern: "*.cumulative.kraken2.output.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Final cumulative report
                path: { "${params.outdir}/kraken2" },
                mode: params.publish_dir_mode,
                pattern: "*.cumulative.kraken2.report.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Aggregation statistics
                path: { "${params.outdir}/kraken2/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "aggregation_stats.json"
            ]
        ]
    }

    withName: 'NANOPLOT' {
        // Reduce memory for development/testing environments
        // NanoPlot can request large amounts of memory on retry (up to 24GB+)
        // Cap at 8GB base, 16GB on first retry (within 18GB system limit)
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
        // Explicit publishDir for frontend compatibility (nanoplot/{sample}/)
        publishDir = [
            path: { "${params.outdir}/nanoplot/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_MERGE_STATS' {
        // QC statistics aggregation (PromethION optimization)
        // Lightweight Python-based weighted statistical calculations
        memory = { 2.GB * task.attempt }
        cpus = { 1 * task.attempt }
        // Changed from: qc/{sample}/stats and qc/{sample}/manifests (2026-03-14 standardization)
        // Cycle 3 (2026-04-25): also publish the cumulative TSV to the flat
        // seqkit/{sample}.tsv path that nanometa_live data_loaders.py reads.
        // Without that publish, the dashboard kept reading the per-batch
        // SEQKIT_STATS file (now relocated to seqkit/{sample}/batch_stats/)
        // and reported the last batch only -- the same overwrite pathology
        // the kraken2 incremental fix already addressed for classification.
        publishDir = [
            [
                path: { "${params.outdir}/seqkit" },
                mode: params.publish_dir_mode,
                pattern: "*.cumulative.tsv",
                enabled: (params.qc_enable_incremental ?: false) || ((params.realtime_mode ?: false) && (params.kraken2_enable_incremental ?: false)),
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    // Drop the .cumulative suffix so the published file
                    // lands at seqkit/{sample}.tsv -- the canonical flat
                    // path the loaders look up first. The full per-sample
                    // stats/ copy below preserves the audit trail.
                    return filename.replaceAll(/\.cumulative\.tsv$/, '.tsv')
                }
            ],
            [
                path: { "${params.outdir}/seqkit/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "*.cumulative.tsv",
                enabled: (params.qc_enable_incremental ?: false) || ((params.realtime_mode ?: false) && (params.kraken2_enable_incremental ?: false)),
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/seqkit/${meta.id}/manifests" },
                mode: params.publish_dir_mode,
                pattern: "*.json",
                enabled: (params.qc_enable_incremental ?: false) || ((params.realtime_mode ?: false) && (params.kraken2_enable_incremental ?: false))
            ]
        ]
    }

    //
    // Pathogen Validation Modules
    // Outputs for Nanometa Live dashboard integration
    //

    withName: 'EXTRACT_READS_BY_TAXID' {
        // Read extraction is lightweight (seqtk subseq)
        memory = { 4.GB * task.attempt }
        cpus = { 2 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation/extracted_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BLASTN_VALIDATION' {
        // BLAST validation against reference genomes
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
        publishDir = [
            [
                // Flat per-(sample,taxid) result. In batch mode this is the
                // final file. In realtime (meta.batch_id set) it is suppressed
                // here -- the cumulative aggregator owns the flat path, and the
                // per-batch copy below preserves each batch.
                path: { "${params.outdir}/validation/blast" },
                mode: params.publish_dir_mode,
                // Use != null (not truthiness): batch_id 0 is the first realtime
                // batch and is Groovy-falsy, so a truthy test would publish it
                // here and skip the per-batch copy below.
                saveAs: { filename -> (filename.equals('versions.yml') || meta.batch_id != null) ? null : filename }
            ],
            [
                // Realtime only: preserve each batch with the batch_id in the name.
                path: { "${params.outdir}/validation/blast/batch" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    if (filename.equals('versions.yml') || meta.batch_id == null) return null
                    return filename.replaceFirst(/(\.blast\.tsv|\.blast_stats\.json)$/, "_${meta.batch_id}\$1")
                }
            ]
        ]
    }

    withName: 'MINIMAP2_VALIDATION' {
        // Minimap2 validation (fast, ONT-optimized)
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
        publishDir = [
            [
                path: { "${params.outdir}/validation/minimap2" },
                mode: params.publish_dir_mode,
                // != null, not truthiness: batch_id 0 (first realtime batch) is falsy.
                saveAs: { filename -> (filename.equals('versions.yml') || meta.batch_id != null) ? null : filename }
            ],
            [
                path: { "${params.outdir}/validation/minimap2/batch" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    if (filename.equals('versions.yml') || meta.batch_id == null) return null
                    return filename.replaceFirst(/(\.paf|\.minimap2_stats\.json)$/, "_${meta.batch_id}\$1")
                }
            ]
        ]
    }

    withName: 'CONSENSUS_VALIDATION' {
        // Amplicon-focused consensus from read mapping (minimap2 + samtools).
        // v1 publishes the flat per-(sample, taxid) consensus only; in realtime
        // mode this is last-batch-wins (no cumulative BAM merge yet).
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation/consensus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Cumulative validation aggregators (realtime only): each batch merges with
    // the prior cumulative file and recomputes stats, publishing the run-so-far
    // result to the canonical flat path the dashboard reads.
    withName: '.*:MINIMAP2_CUMULATIVE_AGGREGATOR' {
        ext.when = { meta.batch_id != null }
        memory = { 2.GB * task.attempt }
        cpus = { 1 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation/minimap2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BLAST_CUMULATIVE_AGGREGATOR' {
        ext.when = { meta.batch_id != null }
        memory = { 2.GB * task.attempt }
        cpus = { 1 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation/blast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'AGGREGATE_VALIDATION_RESULTS' {
        // Aggregation is lightweight Python processing
        memory = { 2.GB * task.attempt }
        cpus = { 1 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'AGGREGATE_VALIDATION_LIVE' {
        // Realtime re-aggregation. Publishes the same validation_results.json as
        // AGGREGATE_VALIDATION_RESULTS, refreshed each batch. maxForks 1
        // serialises the writes so concurrent realtime tasks cannot race on the
        // published file; each run rebuilds the complete run-so-far JSON.
        maxForks = 1
        memory = { 2.GB * task.attempt }
        cpus = { 1 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: params.publish_dir_mode,
            overwrite: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // tmp-folder hygiene for tools that spill to /tmp by default
    //
    withName: 'UNTAR' {
        // GNU tar -a shells out to gzip/xz/zstd helpers that buffer
        // back-pressured stdout via $TMPDIR. On large Kraken2 DB
        // archives (4-16 GB) this can exhaust node-local /tmp.
        // Override TMPDIR to the task workDir so spills land where
        // Nextflow expects.
        beforeScript = 'export TMPDIR="$PWD"'
    }

    withName: 'MINIMAP2_ALIGN' {
        // samtools sort writes shards as samtools.<pid>.tmp.NNNN.bam.
        // Without an explicit -T prefix the prefix is derived from
        // the output path which can collide on shared filesystems.
        // The args2 channel is consumed by the upstream module's
        // 'samtools sort' invocation (nf-core/modules/minimap2/align).
        // Latent today (assembly subworkflow runs with bam_format =
        // false) but pre-emptively add -T to be safe when BAM output
        // is re-enabled.
        ext.args2 = { '-T sort_tmp' }
    }

    //
    // Canonical Output Modules
    // Outputs: canonical/{category}/ - tool-agnostic intermediate formats
    //

    withName: 'CANONICAL_CLASSIFICATION_WRITER' {
        publishDir = [
            path: { "${params.outdir}/canonical/classification" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CANONICAL_QC_WRITER' {
        publishDir = [
            path: { "${params.outdir}/canonical/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CANONICAL_VALIDATION_WRITER' {
        publishDir = [
            path: { "${params.outdir}/canonical/validation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CANONICAL_ASSEMBLY_WRITER' {
        publishDir = [
            path: { "${params.outdir}/canonical/assembly" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MANIFEST_WRITER' {
        publishDir = [
            path: { "${params.outdir}/canonical" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
