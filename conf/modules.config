/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
        // Reduce memory for development/testing
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
    }

    withName: 'CHOPPER' {
        ext.args2 = [
            params.chopper_quality ? "--quality ${params.chopper_quality}" : '',
            params.chopper_minlength ? "--minlength ${params.chopper_minlength}" : '',
            params.chopper_maxlength ? "--maxlength ${params.chopper_maxlength}" : '',
            params.chopper_headcrop ? "--headcrop ${params.chopper_headcrop}" : '',
            params.chopper_tailcrop ? "--tailcrop ${params.chopper_tailcrop}" : ''
        ].join(' ').trim()
        ext.prefix = { "${meta.id}.chopped" }
        // Reduce memory for development/testing (default is 36 GB from process_medium)
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
        // Standardized output naming for Nanometa Live integration
        publishDir = [
            path: { "${params.outdir}/chopper" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KRAKEN2_KRAKEN2' {
        // Reduce memory for development/testing with MiniKraken2 database (8GB)
        // Standard Kraken2 module uses process_high (72 GB) which is too much for dev environments
        memory = { 12.GB * task.attempt }  // 12GB for 8GB database + overhead
        cpus = 8  // Fixed: don't scale CPUs on retry (memory scaling handles OOM)
        // Standardized output naming for Nanometa Live integration
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.endsWith('.report.txt')) return "${meta.id}.kraken2.report.txt"
                if (filename.endsWith('.classified.fastq.gz')) return "${meta.id}.kraken2.classified.fastq.gz"
                if (filename.endsWith('.unclassified.fastq.gz')) return "${meta.id}.kraken2.unclassified.fastq.gz"
                return filename
            }
        ]
    }

    withName: 'KRAKEN2_INCREMENTAL_CLASSIFIER' {
        // Incremental classification with batch caching (PromethION optimization)
        // Same resource requirements as standard KRAKEN2_KRAKEN2
        // SCALABLE STREAMING: maxForks controlled by max_classification_forks parameter
        memory = { 12.GB * task.attempt }  // 12GB for 8GB database + overhead
        cpus = 8  // Fixed: don't scale CPUs on retry (memory scaling handles OOM)
        maxForks = { params.max_classification_forks ?: 8 }
        fair = true  // Equitable scheduling across samples
        publishDir = [
            [
                path: { "${params.outdir}/kraken2/${meta.id}/reports" },
                mode: params.publish_dir_mode,
                pattern: "*.report.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: 'KRAKEN2_OUTPUT_MERGER' {
        // SCALABLE STREAMING: Stateless batch file storage
        // Per-sample parallelism with bounded concurrency
        memory = { 4.GB * task.attempt }
        cpus = 2
        maxForks = { (params.max_classification_forks ?: 8) * 2 }  // Allow 2x classifier forks (lightweight)
        publishDir = [
            [
                // Per-sample batch output files
                path: { "${params.outdir}/kraken2/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "batches/*",
                enabled: params.kraken2_enable_incremental,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Per-sample batch report files
                path: { "${params.outdir}/kraken2/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "batch_reports/*",
                enabled: params.kraken2_enable_incremental,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Merge statistics
                path: { "${params.outdir}/kraken2/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "merge_stats.json",
                enabled: params.kraken2_enable_incremental
            ]
        ]
    }

    withName: 'KRAKEN2_REPORT_GENERATOR' {
        // SCALABLE STREAMING: Stateless per-batch report processing
        // Bounded concurrency to prevent memory exhaustion
        memory = { 6.GB * task.attempt }
        cpus = 2
        maxForks = { (params.max_classification_forks ?: 8) * 2 }  // Allow 2x classifier forks (lightweight)
        publishDir = [
            [
                // Per-batch report with standardized naming
                path: { "${params.outdir}/kraken2/${meta.id}/batch_reports" },
                mode: params.publish_dir_mode,
                pattern: "*_batch*.kraken2.report.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Per-batch taxid counts
                path: { "${params.outdir}/kraken2/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "batch_taxid_counts.json",
                saveAs: { filename -> "batch_${meta.batch_id}_taxid_counts.json" }
            ],
            [
                // Report statistics
                path: { "${params.outdir}/kraken2/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "report_stats.json",
                saveAs: { filename -> "batch_${meta.batch_id}_report_stats.json" }
            ]
        ]
    }

    withName: 'KRAKEN2_FINAL_AGGREGATOR' {
        // End-of-session aggregation: concatenates batch files into cumulative outputs
        // Runs once per sample at end of real-time session
        memory = { 8.GB * task.attempt }
        cpus = 2
        publishDir = [
            [
                // Final cumulative output for downstream tools
                path: { "${params.outdir}/kraken2" },
                mode: params.publish_dir_mode,
                pattern: "*.cumulative.kraken2.output.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Final cumulative report
                path: { "${params.outdir}/kraken2" },
                mode: params.publish_dir_mode,
                pattern: "*.cumulative.kraken2.report.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                // Aggregation statistics
                path: { "${params.outdir}/kraken2/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "aggregation_stats.json"
            ]
        ]
    }

    withName: 'NANOPLOT' {
        // Reduce memory for development/testing environments
        // NanoPlot can request large amounts of memory on retry (up to 24GB+)
        // Cap at 8GB base, 16GB on first retry (within 18GB system limit)
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
    }

    withName: 'SEQKIT_MERGE_STATS' {
        // QC statistics aggregation (PromethION optimization)
        // Lightweight Python-based weighted statistical calculations
        memory = { 2.GB * task.attempt }
        cpus = { 1 * task.attempt }
        publishDir = [
            [
                path: { "${params.outdir}/qc/${meta.id}/stats" },
                mode: params.publish_dir_mode,
                pattern: "*.cumulative.tsv",
                enabled: params.qc_enable_incremental,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/qc/${meta.id}/manifests" },
                mode: params.publish_dir_mode,
                pattern: "*.json",
                enabled: params.qc_enable_incremental
            ]
        ]
    }

    //
    // Pathogen Validation Modules
    // Outputs for Nanometa Live dashboard integration
    //

    withName: 'EXTRACT_READS_BY_TAXID' {
        // Read extraction is lightweight (seqtk subseq)
        memory = { 4.GB * task.attempt }
        cpus = { 2 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation/extracted_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BLASTN_VALIDATION' {
        // BLAST validation against reference genomes
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation/blast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_VALIDATION' {
        // Minimap2 validation (fast, ONT-optimized)
        memory = { 8.GB * task.attempt }
        cpus = { 4 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation/minimap2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'AGGREGATE_VALIDATION_RESULTS' {
        // Aggregation is lightweight Python processing
        memory = { 2.GB * task.attempt }
        cpus = { 1 * task.attempt }
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
