/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    foi-bioinformatics/nanometanf Nextflow config file for MinION
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Optimized configuration for MinION sequencing platform

    Key optimizations:
    - Single-sample focus: Maximize per-sample processing speed
    - High per-process CPU allocation for faster completion
    - Real-time optimizations for incremental data processing
    - Database memory-mapping for batch efficiency

    Target hardware: MinION/GridION without GPU
    Expected dataset: Single sample or low multiplexing (1-4 barcodes), 100K-1M reads
    Strategy: Speed over parallelism - complete each sample as fast as possible
----------------------------------------------------------------------------------------
*/

params {
    // Automatically enable real-time optimizations
    realtime_mode = true

    // Phase 1 optimizations (tuned for single sample)
    kraken2_enable_incremental = true
    qc_enable_incremental = true
    nanoplot_realtime_skip_intermediate = true
    nanoplot_batch_interval = 5          // More frequent for single sample (every 5th batch)
    multiqc_realtime_final_only = true

    // Kraken2 RAM request, resolved by conf/modules.config into the memory
    // directive. A profile withName block cannot do this: modules.config is
    // included after the profiles and overrides them.
    kraken2_memory_gb = 64

    // Resource ceilings for this platform. Set as params rather than inlined in
    // resourceLimits so an explicit --max_cpus / --max_memory on the command line
    // still overrides them (CLI params outrank config params).
    max_cpus = 16
    max_memory = '64.GB'

    // Default to a single Kraken2 fork so single-sample MinION runs use
    // the full CPU budget. Multi-sample MinION runs (4 barcodes on a
    // 16-core GridION host) should override this to 4, which scales the
    // per-task CPU allocation below proportionally.
    max_classification_forks = 1

    // Phase 2 optimization (auto-enabled in real-time mode)
    // Database preloading via memory-mapping handled automatically
}

process {
    // MinION resource ceiling. The fallbacks these entries used to carry
    // (`params.max_memory ? ... : '64.GB'`) were unreachable: max_memory is
    // declared in nextflow.config with a truthy default of '128.GB', so the
    // ternary always took the params branch and the platform ceiling never
    // applied. The profile now sets those params itself (above), which both
    // makes the ceiling real and leaves the CLI able to override it.
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory as String,
        time:   '48.h'
    ]

    // MinION-specific time/memory overrides only. Kraken2 CPU
    // allocation lives in conf/modules.config and scales with
    // params.max_classification_forks (set to 1 above for single-sample
    // MinION; raise to 4 for multi-sample GridION runs).

    // Kraken2 memory and CPUs are NOT set here. conf/modules.config is the last
    // includeConfig before the error-isolation overlay, so its withName blocks win
    // over anything a profile sets for the same directive -- every memory/cpus
    // line these profiles used to carry was dead, and the effective memory was
    // modules.config's `params.kraken2_memory_gb ?: 12` default. Set the param
    // instead (params block above); modules.config resolves the directive from it.
    // `time` is NOT set in modules.config, so the time lines below do apply.

    withName:'KRAKEN2_KRAKEN2' {
        time   = { 8.h   * task.attempt }
    }

    withName:'KRAKEN2_OPTIMIZED' {
        time   = { 8.h   * task.attempt }
    }

    withName:'KRAKEN2_INCREMENTAL_CLASSIFIER' {
        time   = { 8.h   * task.attempt }
    }

    withName:'FASTP' {
        cpus   = { 4     * task.attempt }  // Higher for speed
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName:'CHOPPER' {
        cpus   = { 4     * task.attempt }  // Higher for speed
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName:'FILTLONG' {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName:'NANOPLOT' {
        cpus   = { 2     * task.attempt }  // Standard allocation
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName:'SEQKIT_STATS' {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
}

executor {
    // Lower concurrency for single-sample focus
    queueSize = 8               // Small queue for single sample
    pollInterval = '10 sec'     // Standard polling
    queueStatInterval = '2 min'
}

// MinION strategy explanation
/*
======================================================================================
MINION PARALLELIZATION STRATEGY
======================================================================================

Scenario: Single sample or low multiplexing (1-4 barcodes), MinION/GridION

Pipeline Parallelization Model:
  - Single sample focus: Maximize per-sample completion speed
  - Higher CPU allocation per process
  - Lower total parallelism (1-2 samples at a time)

Example Timeline (8-core system):

  MinION profile (8 CPUs/Kraken2):
    - Can run 1 Kraken2 task at a time
    - Each sample completes in minimum time
    - Total time: 1 sample x 10 batches x 3min = 30 minutes
    - Throughput: Optimized for single sample completion

  PromethION profile (4 CPUs/Kraken2):
    - Can run 2 Kraken2 tasks at a time
    - Each sample takes longer (reduced resources)
    - Total time: 1 sample x 10 batches x 5min = 50 minutes
    - Throughput: Worse for single sample, better for 4+ samples

Key Benefits:
  1. Per-sample speed: Fastest completion for 1-4 samples
  2. Resource maximization: Use all available CPUs for single sample
  3. Real-time responsiveness: Fast turnaround for each batch
  4. Optimal for MinION use case: Single pathogen identification

Automatic Optimizations (Phase 1 & 2):
  OK Incremental Kraken2: Avoid re-classification
  OK QC stats aggregation: Eliminate redundant computations
  OK Conditional NanoPlot: Every 5th batch (more frequent than PromethION)
  OK Deferred MultiQC: Run once at end
  OK Database preloading: Memory-mapped database caching

Usage:
  nextflow run foi-bioinformatics/nanometanf \\
    -profile minion \\
    --input samplesheet.csv \\
    --realtime_mode \\
    --nanopore_output_dir /sequencing/output \\
    --kraken2_db /databases/kraken2 \\
    --max_cpus 8 \\
    --max_memory 64.GB \\
    --outdir results/

Typical Hardware:
  - MinION Mk1B/Mk1C: 8-16 cores, 16-32 GB RAM
  - GridION: 20 cores, 128 GB RAM

======================================================================================
*/
