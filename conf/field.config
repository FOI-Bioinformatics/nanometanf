/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    foi-bioinformatics/nanometanf Nextflow config file for field sequencing
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Optimized for resource-constrained hardware such as gaming laptops or
    portable workstations used during field deployments.

    Key optimizations:
    - Strict 15 GB memory ceiling -- all processes fit within a single machine
    - Serial Kraken2 execution (1 fork) to avoid memory contention
    - Lightweight QC: NanoPlot skipped by default, Chopper with minimal memory
    - Smaller Kraken2 databases assumed (MiniKraken2 ~8 GB or custom field DB)
    - Aggressive batch deduplication to reduce total work

    Target hardware: Gaming laptop / portable workstation, 15 GB RAM, 4-8 cores
    Expected dataset: 1-4 barcodes, MinION Mk1B/Mk1C, field or point-of-care
    Strategy: Fit entirely in RAM -- never swap, never OOM
----------------------------------------------------------------------------------------
*/

params {
    // Real-time optimizations
    realtime_mode = true

    // Incremental processing (essential to avoid reprocessing on limited hardware)
    kraken2_enable_incremental = true
    qc_enable_incremental = true

    // Skip heavy QC to save memory
    skip_nanoplot = true
    multiqc_realtime_final_only = true

    // Disable memory-mapping by default (safer on diverse hardware)
    kraken2_memory_mapping = false

    // Conservative concurrency
    max_classification_forks = 1

    // Kraken2 RAM request, resolved by conf/modules.config into the memory
    // directive. The withName blocks below cannot do this -- modules.config is
    // included after the profiles and overrides them.
    kraken2_memory_gb = 10

    // Smaller batches to limit per-process peak memory
    batch_size = 5

    // Assembly on field hardware. The scope default is targeted: one
    // organism's reads are a far smaller job than a whole community, and on
    // shallow field input a whole-sample assembly is declined by the yield
    // floor anyway. Assembly stays opt-in via enable_assembly; these only
    // decide what it does when an operator switches it on.
    assembly_scope = 'targeted'
}

process {
    // Hard resource ceiling: 15 GB system, leave ~2 GB for OS and Nextflow JVM
    resourceLimits = [
        cpus: 8,
        memory: '13.GB',
        time: '48.h'
    ]

    // Kraken2 memory and CPUs are NOT set here. conf/modules.config is the last
    // includeConfig before the error-isolation overlay, so its withName blocks win
    // over anything a profile sets for the same directive -- every memory/cpus
    // line these profiles used to carry was dead, and the effective memory was
    // modules.config's `params.kraken2_memory_gb ?: 12` default. Set the param
    // instead (params block above); modules.config resolves the directive from it.
    // `time` is NOT set in modules.config, so the time lines below do apply.

    withName:'KRAKEN2_KRAKEN2' {
        time   = { 8.h   * task.attempt }
    }

    withName:'KRAKEN2_OPTIMIZED' {
        time   = { 8.h   * task.attempt }
    }

    withName:'KRAKEN2_INCREMENTAL_CLASSIFIER' {
        time   = { 8.h   * task.attempt }
    }

    withName:'FASTP' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // Assembly is the longest-running step and the one that can hold the
    // machine. process_high asks for 16.h * attempt, which under the 48.h
    // ceiling above lets a wedged Flye occupy a field laptop for two days --
    // useless for a triage tool. maxForks is set in conf/modules.config
    // (which wins for directives it sets); `time` is not set there, so these
    // ceilings do apply.
    withName:'FLYE|MINIASM|MINIMAP2_AVA' {
        cpus   = 4
        time   = { 4.h * task.attempt }
    }

    withName:'CHOPPER' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    withName:'FILTLONG' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    withName:'NANOPLOT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    withName:'SEQKIT_STATS' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
}

executor {
    // Serial execution to avoid memory contention
    queueSize = 4
    pollInterval = '15 sec'
    queueStatInterval = '2 min'
}

/*
======================================================================================
FIELD SEQUENCING STRATEGY
======================================================================================

Scenario: 1-4 barcodes, MinION on a gaming laptop (15 GB RAM, 4-8 cores)

Memory budget (15 GB total):
  ~2 GB   OS + Nextflow JVM
  ~10 GB  Kraken2 (MiniKraken2 8 GB DB + overhead)
  ~2 GB   QC (Chopper/FASTP)
  ~1 GB   Reporting / merger

Assembly is deliberately absent from that budget: it is opt-in, and it does
not fit beside a resident Kraken2 database. When an operator enables it, only
one assembly runs at a time (maxForks 1 in conf/modules.config) and it is
capped at 4 hours here, so a wedged assembler cannot hold the machine for the
48 hours the global ceiling would otherwise allow. The scope defaults to
targeted, which assembles one organism's reads rather than the whole sample.

Key constraints:
  - Only 1 Kraken2 fork at a time (max_classification_forks = 1)
  - Assembly, if enabled, runs one task at a time and is capped at 4 h
  - NanoPlot skipped (memory-intensive, not essential for field ID)
  - Memory-mapping disabled (diverse hardware, avoid SIGSEGV on edge cases)
  - resourceLimits caps at 13 GB (2 GB reserved for OS)
  - Smaller batch_size (5) to reduce per-batch peak memory

Recommended databases for field use:
  - MiniKraken2 v2 (~8 GB) -- general purpose
  - Custom field DB (<4 GB) -- targeted pathogen panel

Usage:
  nextflow run foi-bioinformatics/nanometanf \
    -profile field,docker \
    --input samplesheet.csv \
    --realtime_mode \
    --nanopore_output_dir /sequencing/output \
    --kraken2_db /databases/minikraken2 \
    --outdir results/

======================================================================================
*/
