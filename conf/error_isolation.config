/*
 * Error isolation configuration for sample-level fault tolerance.
 *
 * Strategy: exit codes 1 and 2 (tool-specific errors such as empty input,
 * malformed reads, or missing references) are ignored so that the remaining
 * samples can proceed. Signal-range exit codes (130-145, including 137 OOM)
 * trigger a retry, up to maxRetries attempts.
 *
 * This file is the SINGLE source of errorStrategy and maxRetries for the
 * processes named below. It is the last includeConfig in nextflow.config, so it
 * overrides conf/base.config and conf/modules.config unconditionally -- which
 * meant the Kraken2 errorStrategy that conf/modules.config also declared (a
 * narrower exit-139 retry with maxRetries = 1) never applied, and the two
 * disagreed on the retry count. Those copies have been removed; add or change a
 * retry policy for these processes here, not there.
 *
 * Exit 139 (SIGSEGV) still retries, because it is not in the ignore set. The
 * Kraken2 modules use task.attempt to drop --memory-mapping on the retry, which
 * is what makes that retry useful on shared filesystems.
 *
 * An ignored failure is an input lost without a word: the trace row names the
 * sample, the manifest names failed SAMPLES, and aggregation_stats.json cannot
 * see a QC-stage loss because batch ids are assigned after QC (nanometa_live
 * round-4 audit, H20). The QC and classification processes therefore run
 * bin/nanometanf_lost_input_marker.sh as their afterScript. Nextflow's task
 * wrapper runs afterScript after the command has exited, in the same shell,
 * with the exit status in $nxf_main_ret; the script writes one JSON marker per
 * exit-1/2 failure under <outdir>/pipeline_info/lost_inputs/ naming the
 * staged input files, and is a no-op for every other exit status (a retried
 * attempt writes nothing).
 */

process {

    // Sample-level QC tools
    withName: 'CHOPPER' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
        afterScript = { "'${projectDir}/bin/nanometanf_lost_input_marker.sh' \"\${nxf_main_ret:-0}\" '${params.outdir}' '${task.process}' '${meta.id}' '${meta.batch_id ?: ''}' '${task.attempt}'" }
    }
    withName: 'FASTP_STREAMING' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
        afterScript = { "'${projectDir}/bin/nanometanf_lost_input_marker.sh' \"\${nxf_main_ret:-0}\" '${params.outdir}' '${task.process}' '${meta.id}' '${meta.batch_id ?: ''}' '${task.attempt}'" }
    }

    // Taxonomic classification tools
    withName: 'KRAKEN2_KRAKEN2' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
        afterScript = { "'${projectDir}/bin/nanometanf_lost_input_marker.sh' \"\${nxf_main_ret:-0}\" '${params.outdir}' '${task.process}' '${meta.id}' '${meta.batch_id ?: ''}' '${task.attempt}'" }
    }
    withName: 'KRAKEN2_OPTIMIZED' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
        afterScript = { "'${projectDir}/bin/nanometanf_lost_input_marker.sh' \"\${nxf_main_ret:-0}\" '${params.outdir}' '${task.process}' '${meta.id}' '${meta.batch_id ?: ''}' '${task.attempt}'" }
    }
    withName: 'KRAKEN2_INCREMENTAL_CLASSIFIER' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
        afterScript = { "'${projectDir}/bin/nanometanf_lost_input_marker.sh' \"\${nxf_main_ret:-0}\" '${params.outdir}' '${task.process}' '${meta.id}' '${meta.batch_id ?: ''}' '${task.attempt}'" }
    }

    // Validation tools
    withName: 'BLASTN_VALIDATION' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
    }
    withName: 'MINIMAP2_VALIDATION' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
    }

    // Assembly tools.
    //
    // All three carry the same policy. FLYE alone was isolated, so a miniasm
    // exit-1 -- routine on thin data, and unavoidable on a platform with no
    // bioconda build -- fell back to base.config's 'finish' and ended the
    // whole run. Measured 2026-09-03: a run whose five samples had all been
    // classified was recorded final_status: error because the optional,
    // experimental assembly step could not create its conda environment. An
    // assembly failure must never discard a screening result.
    //
    // The markers matter as much as the strategy: an ignored failure is
    // invisible without one, and assembly was the only isolated process
    // without an afterScript. read_lost_inputs already renders these in the
    // header and the exported report, so the marker is the whole GUI wiring.
    withName: 'FLYE' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
        afterScript = { "'${projectDir}/bin/nanometanf_lost_input_marker.sh' \"\${nxf_main_ret:-0}\" '${params.outdir}' '${task.process}' '${meta.id}' '${meta.batch_id ?: ''}' '${task.attempt}'" }
    }
    withName: 'MINIASM' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
        afterScript = { "'${projectDir}/bin/nanometanf_lost_input_marker.sh' \"\${nxf_main_ret:-0}\" '${params.outdir}' '${task.process}' '${meta.id}' '${meta.batch_id ?: ''}' '${task.attempt}'" }
    }
    withName: 'MINIMAP2_AVA' {
        errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
        maxRetries = 2
        afterScript = { "'${projectDir}/bin/nanometanf_lost_input_marker.sh' \"\${nxf_main_ret:-0}\" '${params.outdir}' '${task.process}' '${meta.id}' '${meta.batch_id ?: ''}' '${task.attempt}'" }
    }
}
