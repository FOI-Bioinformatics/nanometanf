/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    foi-bioinformatics/nanometanf large-host server profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Profile for 32+ core servers (40, 96, ...).

    Unlike the older promethion / promethion_8 / production profiles, this
    profile drops the per-process cpu hardcodes that pin nanometanf to a
    fixed footprint regardless of host size, and asserts a higher
    resourceLimits ceiling so process_high tasks can actually claim more
    cores when the operator sets --max_cpus appropriately.

    Usage examples:

        # 40-thread server, 256 GB RAM
        nextflow run foi-bioinformatics/nanometanf \\
            -profile server,conda \\
            --max_cpus 40 --max_memory 256.GB \\
            --max_classification_forks 10 \\
            ...

        # 96-thread server, 512 GB RAM
        nextflow run foi-bioinformatics/nanometanf \\
            -profile server,conda \\
            --max_cpus 96 --max_memory 512.GB \\
            --max_classification_forks 24 \\
            ...

    Scaling rule of thumb:
        max_classification_forks = max_cpus / 4

    Each Kraken2 task uses 8 cpus and is mostly I/O-bound on the database
    fetch, so 2x overcommit (forks * 8 = max_cpus * 2) is healthy. Drop
    forks closer to max_cpus / 8 on rotational storage or a cold cache.

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Server'
    config_profile_description = 'Server profile for 32+ core hosts; drops per-process cpu hardcodes and raises resourceLimits.'
    config_profile_contact     = 'andreas.sjodin@foi.se'
    config_profile_url         = 'https://github.com/foi-bioinformatics/nanometanf'

    // Operators MUST set --max_cpus, --max_memory, and
    // --max_classification_forks at the CLI to match their host. The
    // defaults below are for a modest 32-core / 128 GB server so the
    // profile is harmless without override flags.
    max_cpus    = 32
    max_memory  = '128.GB'
    max_time    = '48.h'

    max_classification_forks    = 8
    max_concurrent_batches      = 8
    max_classification_attempts = 3
}

process {
    // Raise the resourceLimits ceiling so the label ladder in base.config
    // can actually scale up on the host. Without this, base.config
    // clamps every task at 8 cpus / 16 GB regardless of profile.
    resourceLimits = [
        cpus: 96,
        memory: '512.GB',
        time: '48.h'
    ]

    // QC tools: drop the modules.config 4-cpu hardcodes and let the label
    // ladder drive sizing. process_medium is 6 cpus * task.attempt by
    // default; that scales to 12 cpus on the second attempt.
    withName: 'FASTP|FASTP_STREAMING|CHOPPER|FASTQC|NANOPLOT|FILTLONG|SEQKIT_STATS|SEQKIT_MERGE_STATS' {
        cpus   = { 6 * task.attempt }
        memory = { 8.GB * task.attempt }
    }

    // Kraken2: 8 cpus per task is the parallelism unit; max_classification_forks
    // governs how many run concurrently. modules.config already sets the
    // maxForks; we leave it in place rather than override here.
    withName: 'KRAKEN2_KRAKEN2|KRAKEN2_INCREMENTAL_CLASSIFIER|KRAKEN2_OPTIMIZED' {
        cpus   = 8
        memory = { (params.kraken2_memory_gb ?: 12).toString() + '.GB' as nextflow.util.MemoryUnit }
    }

    // Aggregation processes are largely single-threaded; do not waste
    // cpus on them so the scheduler can fan out more Kraken2 / QC jobs.
    withName: 'KRAKEN2_OUTPUT_MERGER|KRAKEN2_REPORT_GENERATOR|KRAKEN2_FINAL_AGGREGATOR|EMIT_EMPTY_KRAKEN2_REPORT|TAXPASTA_STANDARDISE|TAXPASTA_MERGE' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }

    // Assembly: scale Flye / Minimap2 to a healthy fraction of host cores.
    withName: 'FLYE|MINIMAP2_ALIGN|MINIASM' {
        cpus   = { 16 * task.attempt }
        memory = { 64.GB * task.attempt }
    }

    // Validation: per-taxid, modest allocation so several organisms
    // validate concurrently.
    withName: 'BLAST_BLASTN|BLAST_MAKEBLASTDB|MINIMAP2_VALIDATION' {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
    }
}
