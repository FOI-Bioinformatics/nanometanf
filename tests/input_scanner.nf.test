nextflow_workflow {

    name "Test INPUT_SCANNER subworkflow"
    script "../subworkflows/local/input_scanner/main.nf"
    workflow "INPUT_SCANNER"

    tag "subworkflow"
    tag "input_scanner"
    tag "fast"

    test("Should detect barcode subdirectories and create per-barcode samples") {

        when {
            workflow {
                """
                input[0] = "$projectDir/tests/fixtures/minknow_output"
                input[1] = null
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.samples.size() >= 2
            // Check sample IDs include barcode names
            def sample_ids = workflow.out.samples.collect { it[0].id }
            assert sample_ids.contains("barcode01")
            assert sample_ids.contains("barcode02")
        }
    }

    test("Custom-named subdirectories are one sample each, named after the folder") {

        when {
            workflow {
                """
                input[0] = "$projectDir/tests/fixtures/custom_sample_dirs"
                input[1] = null
                """
            }
        }

        then {
            assert workflow.success
            def sample_ids = workflow.out.samples.collect { it[0].id }.sort()
            assert sample_ids == ["Turex", "Zymo"]
        }
    }

    test("Should group flat files by sample_regex") {

        when {
            workflow {
                """
                input[0] = "$projectDir/tests/fixtures/flat_multisample"
                input[1] = "(sample[A-Z])_"
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.samples.size() >= 2
            def sample_ids = workflow.out.samples.collect { it[0].id }
            assert sample_ids.contains("sampleA")
            assert sample_ids.contains("sampleB")
        }
    }

    test("Should handle barcode_input_dir backward compatibility") {

        when {
            workflow {
                """
                input[0] = "$projectDir/tests/fixtures/barcode_structure"
                input[1] = null
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.samples.size() >= 2
        }
    }

    test("per_file: flat files with no regex become one sample each (by stem)") {

        when {
            workflow {
                """
                input[0] = "$projectDir/tests/fixtures/flat_multisample"
                input[1] = null
                """
            }
        }

        then {
            assert workflow.success
            // sampleA_001.fastq.gz + sampleB_001.fastq.gz -> 2 samples keyed by file stem
            assert workflow.out.samples.size() == 2
            def ids = workflow.out.samples.collect { it[0].id }.sort()
            assert ids == ['sampleA_001', 'sampleB_001']
            // each sample carries exactly its own single file
            assert workflow.out.samples.every { (it[1] instanceof List ? it[1] : [it[1]]).size() == 1 }
        }
    }

    test("single_sample: params.sample_name merges all flat files into one sample") {

        when {
            params {
                sample_name = 'merged'
            }
            workflow {
                """
                input[0] = "$projectDir/tests/fixtures/flat_multisample"
                input[1] = null
                """
            }
        }

        then {
            assert workflow.success
            // sample_name overrides per-file ids -> a single merged sample
            assert workflow.out.samples.size() == 1
            assert workflow.out.samples.get(0).get(0).id == 'merged'
            // the merged sample holds both input files
            def files = workflow.out.samples.get(0).get(1)
            assert (files instanceof List ? files : [files]).size() == 2
        }
    }

    test("Should ignore macOS AppleDouble sidecar files") {

        // macOS writes "._<name>" AppleDouble sidecars beside every file on
        // exFAT/USB media (the normal field-laptop transfer path). They are
        // not gzip, so scanning them as FASTQ fails CHOPPER downstream.
        when {
            workflow {
                """
                input[0] = "$projectDir/tests/fixtures/appledouble_input"
                input[1] = null
                """
            }
        }

        then {
            assert workflow.success
            def all_files = workflow.out.samples.collectMany { it[1] instanceof List ? it[1] : [it[1]] }
            def names = all_files.collect { file(it.toString()).name }
            assert names.contains("sample.fastq.gz")
            assert !names.any { it.startsWith("._") }
        }
    }

}
