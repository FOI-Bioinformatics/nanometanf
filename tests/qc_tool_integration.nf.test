nextflow_pipeline {

    name "Multi-tool QC Integration Test - Output Standardization"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "qc"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    test("Should produce standardized outputs with CHOPPER (default QC tool)") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"

                // CHOPPER is the default
                qc_tool = 'chopper'
                chopper_quality = 10
                chopper_minlength = 1000

                // Fast execution
                skip_nanoplot = true
                skip_multiqc = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '10.min'

                // Disable resource-intensive steps
                skip_kraken2 = true
                blast_validation = false
                realtime_mode = false
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Should produce standardized outputs with FASTP") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"

                // Use FASTP
                qc_tool = 'fastp'
                fastp_qualified_quality = 15
                fastp_length_required = 1000

                // Fast execution
                skip_nanoplot = true
                skip_multiqc = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '10.min'

                // Disable resource-intensive steps
                skip_kraken2 = true
                blast_validation = false
                realtime_mode = false
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Should produce standardized outputs with FILTLONG") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"

                // Use FILTLONG
                qc_tool = 'filtlong'
                filtlong_min_length = 1000
                filtlong_keep_percent = 90

                // Fast execution
                skip_nanoplot = true
                skip_multiqc = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '10.min'

                // Disable resource-intensive steps
                skip_kraken2 = true
                blast_validation = false
                realtime_mode = false
            }
        }

        then {
            // FILTLONG has a known platform-specific (ARM) flakiness, so we do
            // not hard-require success -- but the run must not abort on a
            // pipeline-logic/channel bug, and the outcome must be attributable to
            // FILTLONG itself. (Was previously `success || failed`, a tautology.)
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            if (workflow.success) {
                assert workflow.trace.tasks().any { it.name.contains('FILTLONG') }
            } else {
                assert err.toLowerCase().contains('filtlong')
            }
        }
    }

    test("Should integrate all QC tools with MultiQC successfully") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"

                // Use default (CHOPPER)
                qc_tool = 'chopper'

                // Enable full QC pipeline
                skip_nanoplot = false
                skip_multiqc = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '10.min'

                // Disable resource-intensive steps
                skip_kraken2 = true
                blast_validation = false
                realtime_mode = false
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Should validate output schema consistency across all QC tools") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"

                // This test uses CHOPPER but validates schema compliance
                qc_tool = 'chopper'

                // Fast execution
                skip_nanoplot = false
                skip_multiqc = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '10.min'

                // Disable resource-intensive steps
                skip_kraken2 = true
                blast_validation = false
                realtime_mode = false
            }
        }

        then {
            assert workflow.success
        }
    }
}
