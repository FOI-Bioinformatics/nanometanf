nextflow_pipeline {

    name "Integration Tests - Complete Workflow Execution"
    script "../../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Execution Speed & Criticality
    tag "slow"
    tag "extended"

    test("Integration: FASTQ processing with full QC and classification") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"
                skip_nanoplot = false
                skip_fastp = false
                kraken2_db = null  // Skip classification in test
                blast_validation = false
                multiqc_title = "Integration Test - FASTQ Processing"
            }
        }

        then {
            assert workflow.success
            assert snapshot(file("${outputDir}/pipeline_info/software_versions.yml")).match("software_versions")
        }

    }

    test("Integration: Dorado basecalling with POD5 inputs") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                use_dorado = true
                pod5_input_dir = "$projectDir/tests/fixtures/pod5"
                dorado_model = "dna_r10.4.1_e4.3_400bps_hac"
                outdir = "$outputDir"
                min_qscore = 9
                trim_adapters = true
                skip_nanoplot = false
            }
        }

        then {
            assert workflow.success
            assert snapshot(file("${outputDir}/pipeline_info/software_versions.yml")).match("software_versions")
        }

    }

    test("Integration: Complete pipeline with demultiplexing") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                use_dorado = true
                pod5_input_dir = "$projectDir/tests/fixtures/pod5"
                barcode_kit = "SQK-NBD114-24"
                trim_barcodes = true
                demultiplex = true
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert snapshot(file("${outputDir}/pipeline_info/software_versions.yml")).match("software_versions")
        }

    }

    test("Integration: Real-time monitoring mode") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "**/*.fastq{,.gz}"
                batch_size = 10
                batch_interval = "5min"
                max_files = 1
                outdir = "$outputDir"
            }
        }

        then {
            // Real-time mode may succeed or fail gracefully
            assert workflow.exitStatus != null
            if (workflow.success) {
                assert snapshot(file("${outputDir}/pipeline_info/software_versions.yml")).match("software_versions")
            }
        }

    }

    test("Integration: Dynamic resource allocation") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                enable_dynamic_resources = true
                optimization_profile = "balanced"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert snapshot(file("${outputDir}/pipeline_info/software_versions.yml")).match("software_versions")
        }

    }

}
