// Test-only config for the lost-input marker case in tests/failure_paths.nf.test.
//
// conf/error_isolation.config ignores CHOPPER exit 1/2 and runs
// bin/nanometanf_lost_input_marker.sh as the afterScript. An unknown flag
// makes chopper exit 2 (a clap usage error), which under `set -o pipefail`
// is the task's exit status: the failure is absorbed, the run completes, and
// the marker must name the input that was lost.
process {
    withName: 'CHOPPER' {
        ext.args2 = '--no-such-flag-for-the-marker-test'
    }
}
