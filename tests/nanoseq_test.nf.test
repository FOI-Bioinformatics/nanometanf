nextflow_pipeline {

    name "Test nanometanf with nf-core nanoseq data"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "qc"

    // Execution Speed & Criticality
    tag "slow"
    tag "core"

    test("Should run with nf-core test data") {

        when {
            params {
                // Use local nf-core test data
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"

                // Disable advanced features for basic test
                use_dorado = false
                realtime_mode = false
                skip_kraken2 = true
                blast_validation = false

                // Enable basic QC
                skip_fastp = false
                skip_nanoplot = false

                // Resource limits for testing
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '30.min'
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/pipeline_info").exists()
            assert workflow.trace.tasks().size() > 0

            // Check that main processes ran (CHOPPER is now default QC tool)
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') || it.name.contains('FASTP') || it.name.contains('FILTLONG') }
            assert workflow.trace.tasks().any { it.name.contains('NANOPLOT') }
            assert workflow.trace.tasks().any { it.name.contains('MULTIQC') }
        }
    }

    test("Should validate Dorado parameters with nf-core data") {

        when {
            params {
                // Use local nf-core test data
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"

                // Test with use_dorado = false - Dorado tests are in dorado_path_fix.nf.test
                use_dorado = false
                realtime_mode = false
                skip_kraken2 = true
                blast_validation = false

                // Resource limits
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/pipeline_info").exists()

            // Should not run Dorado
            assert !workflow.trace.tasks().any { it.name.contains('DORADO') }

            // Should run standard QC workflow (CHOPPER is default)
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') || it.name.contains('FASTP') || it.name.contains('FILTLONG') }
        }
    }

    test("Should handle workflow without Dorado (FASTQ-only mode)") {

        when {
            params {
                // Test FASTQ-only mode without Dorado
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"

                skip_kraken2 = true
                blast_validation = false
                use_dorado = false
                realtime_mode = false

                // Quick test
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '10.min'
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/pipeline_info").exists()

            // Should not run Dorado
            assert !workflow.trace.tasks().any { it.name.contains('DORADO') }
            // Should run FASTQ processing with CHOPPER (default QC tool)
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') || it.name.contains('FASTP') || it.name.contains('FILTLONG') }
        }
    }
}
