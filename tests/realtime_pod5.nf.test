// Test real-time mode with POD5 files using Dorado basecalling
// This tests watchPath monitoring of POD5 files with real-time basecalling
// Uses realtime_mode=true, use_dorado=true, and pod5_input_dir
nextflow_pipeline {

    name "Test real-time mode with POD5 files and Dorado basecalling"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"
    tag "realtime"

    // Feature Area (use standard tags from TAGGING_GUIDE.md)
    // Note: "basecalling" covers Dorado functionality
    tag "basecalling"

    // Execution Speed & Criticality
    tag "slow"
    tag "extended"

    test("Should process POD5 files in real-time mode with Dorado") {

        when {
            params {
                input = false
                // Real-time POD5 basecalling mode
                realtime_mode = true
                use_dorado = true
                nanopore_output_dir = "$projectDir/tests/fixtures/pod5"
                file_pattern = "**/*.pod5"
                dorado_model = "dna_r10.4.1_e4.3_400bps_fast"
                outdir = "$outputDir"

                // Critical: limit files to prevent watchPath hanging
                max_files = 3
                batch_size = 2

                // Disable other features
                skip_kraken2 = true
                blast_validation = false
                skip_nanoplot = true
                enable_realtime_stats = false

                // Resource limits
                max_cpus = 2
                max_memory = '8.GB'
                max_time = '30.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0

            // Check that Dorado basecalling ran
            assert workflow.trace.tasks().any { it.name.contains('DORADO') }

            // Check downstream processing
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }
        }
    }
}
