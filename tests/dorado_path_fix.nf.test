nextflow_process {

    name "Test DORADO_BASECALLER with custom dorado_path"
    script "modules/local/dorado_basecaller/main.nf"
    process "DORADO_BASECALLER"

    options "-stub"

    // Test Level & Component
    tag "module"
    tag "dorado_basecaller"

    // Feature Area
    tag "basecalling"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    // Test Type
    tag "stub"
    tag "snapshot"

    test("Should use custom dorado_path parameter - stub") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_custom_path', single_end: true ],
                    []
                ]
                input[1] = 'dna_r10.4.1_e4.3_400bps_hac'
                input[2] = 10       // min_qscore
                input[3] = true     // trim_adapters
                input[4] = false    // trim_barcodes
                input[5] = false    // demultiplex
                input[6] = ''       // barcode_kit
                input[7] = '/custom/path/to/dorado'  // dorado_path
                input[8] = 'auto'   // dorado_device
                """
            }
            params {
                outdir = "$outputDir"
                skip_kraken2 = true
                blast_validation = false
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match("versions") }
            )
        }
    }

    test("Should use default dorado from PATH - stub") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_default_path', single_end: true ],
                    []
                ]
                input[1] = 'dna_r10.4.1_e4.3_400bps_hac'
                input[2] = 9        // min_qscore
                input[3] = false    // trim_adapters
                input[4] = false    // trim_barcodes
                input[5] = false    // demultiplex
                input[6] = ''       // barcode_kit
                input[7] = 'dorado' // dorado_path (default)
                input[8] = 'auto'   // dorado_device
                """
            }
            params {
                outdir = "$outputDir"
                skip_kraken2 = true
                blast_validation = false
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match("versions_default") }
            )
        }
    }

    test("Should handle null dorado_path gracefully - stub") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_null_path', single_end: true ],
                    []
                ]
                input[1] = 'dna_r10.4.1_e4.3_400bps_sup'
                input[2] = 12       // min_qscore
                input[3] = false    // trim_adapters
                input[4] = false    // trim_barcodes
                input[5] = false    // demultiplex
                input[6] = ''       // barcode_kit
                input[7] = ''       // dorado_path (empty, should fall back to 'dorado')
                input[8] = 'auto'   // dorado_device
                """
            }
            params {
                outdir = "$outputDir"
                skip_kraken2 = true
                blast_validation = false
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fastq },
                { assert process.out.summary },
                { assert snapshot(process.out.versions).match("versions_null") }
            )
        }
    }

    test("Summary should include dorado path information - stub") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_summary', single_end: true ],
                    []
                ]
                input[1] = 'dna_r10.4.1_e4.3_400bps_hac'
                input[2] = 9        // min_qscore
                input[3] = true     // trim_adapters
                input[4] = false    // trim_barcodes
                input[5] = false    // demultiplex
                input[6] = ''       // barcode_kit
                input[7] = '/usr/local/dorado-1.2.0/bin/dorado'  // dorado_path
                input[8] = 'auto'   // dorado_device
                """
            }
            params {
                outdir = "$outputDir"
                skip_kraken2 = true
                blast_validation = false
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.summary },
                { assert process.out.summary[0][1].toString().endsWith('_summary.txt') },
                { assert snapshot(process.out.versions).match("versions_summary") }
            )
        }
    }

    test("Should work with paired-end reads - stub") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_paired', single_end: false ],
                    []
                ]
                input[1] = 'dna_r10.4.1_e4.3_400bps_hac'
                input[2] = 9        // min_qscore
                input[3] = true     // trim_adapters
                input[4] = true     // trim_barcodes
                input[5] = false    // demultiplex
                input[6] = ''       // barcode_kit
                input[7] = '/opt/dorado/dorado'  // dorado_path
                input[8] = 'auto'   // dorado_device
                """
            }
            params {
                outdir = "$outputDir"
                skip_kraken2 = true
                blast_validation = false
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fastq },
                { assert process.out.fastq[0][1].toString().endsWith('.fastq.gz') },
                { assert snapshot(process.out.versions).match("versions_paired") }
            )
        }
    }
}
