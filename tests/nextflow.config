/*
========================================================================================
    Nextflow config file for running tests
========================================================================================

    Container engine selection is profile-driven. Earlier revisions of this file
    force-enabled docker globally, which silently overrode -profile conda and
    caused nf-test invocations to attempt docker container pulls even when the
    operator had explicitly selected a conda profile. The container blocks below
    are now activated only when the matching profile is selected, leaving
    -profile conda (and the empty default profile in nf-test.config) free of
    container engine state.
*/

process {
    executor = 'local'

    // Resource limits for testing
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

profiles {
    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
    }
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }
    conda {
        conda {
            enabled = true
        }
    }
}

// Test-specific parameters
params {
    max_cpus = 2
    max_memory = '6.GB'
    max_time = '1.h'
}
params.modules_testdata_base_path = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/"
params.pipelines_testdata_base_path = "https://raw.githubusercontent.com/nf-core/test-datasets/"
