nextflow_pipeline {

    name "Validation-only entry discovers samples from a multiplexed run"
    script "../main.nf"

    // Regression guard for the on-demand validation path (2026-08-18).
    // The GUI invokes `--validation_only` against an existing outdir with
    // `--reads_dir` pointing at the ORIGINAL input directory. Under
    // by_barcode sample handling that directory holds barcode subfolders
    // (barcode01/reads.fastq.gz), which the old flat glob
    // `${reads_dir}/*.fastq{,.gz}` could not see -- every multiplexed
    // on-demand validation died with "No FASTQ files found" before a single
    // process ran. Even for flat layouts the glob was fragile: the file STEM
    // became meta.id, and unless it happened to equal the Kraken2 sample id
    // the join in the validation subworkflow silently dropped the sample.
    //
    // The classified FASTQ pools the original run published into
    // kraken2_output_dir (*.kraken2.classified.fastq.gz) have neither
    // problem: one file per sample, stem == sample id, and they are the same
    // read pool main-mode validation consumes. The entry now prefers them.

    tag "pipeline"
    tag "validation"
    tag "validation_only"
    tag "stub"

    test("by_barcode reads_dir with classified FASTQs in kraken2_output_dir") {
        options "-stub"
        when {
            params {
                // The test profile sets a samplesheet; the schema allows exactly
                // one input mode and validation-only is one of them.
                input = null
                validation_only = true
                run_validation = true
                outdir = "$outputDir"
                reads_dir = "$projectDir/tests/fixtures/validation_only/reads"
                kraken2_output_dir = "$projectDir/tests/fixtures/validation_only/kraken2"
                pathogen_genomes = "$projectDir/tests/fixtures/validation/test_genomes.json"
                taxids_to_validate = '562'
                validation_method = 'both'
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }
        then {
            assert workflow.success :
                "validation_only failed against a by_barcode input layout: " +
                ((workflow.errorReport ?: '') + '\n' +
                 (workflow.stdout?.join('\n') ?: '')).take(400)
        }
    }

    test("incremental layout: cumulative per-read output and pooled classified FASTQ are discovered") {
        // The default classifier path (real time, chunked batch mode, or
        // kraken2_enable_incremental) publishes no <sample>.kraken2.output.txt:
        // the per-read output is the end-of-session
        // <sample>.cumulative.kraken2.output.txt, and the flat
        // <sample>.kraken2.report.txt beside the cumulative report is the
        // zero-read placeholder for a batch that produced nothing. Globbed as
        // a stem the cumulative file was the sample "barcode01.cumulative",
        // matched no read pool, and the join dropped both halves with
        // "skipping sample ... has only one of the two required Kraken2
        // outputs" -- every on-demand validation after a default GUI run
        // found nothing (bug audit 2026-11-06, finding 4).
        options "-stub"
        when {
            params {
                input = null
                validation_only = true
                run_validation = true
                outdir = "$outputDir"
                reads_dir = "$projectDir/tests/fixtures/validation_only/reads"
                kraken2_output_dir = "$projectDir/tests/fixtures/validation_only_incremental/kraken2"
                pathogen_genomes = "$projectDir/tests/fixtures/validation/test_genomes.json"
                taxids_to_validate = '562'
                validation_method = 'both'
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }
        then {
            def out = ((workflow.stdout ?: []) + (workflow.stderr ?: [])).join('\n')
            assert workflow.success :
                "validation_only failed against an incremental-layout outdir: " +
                ((workflow.errorReport ?: '') + '\n' + out).take(400)
            assert !out.contains('has only one of the two required Kraken2 outputs') :
                "the sample was dropped at the classified-reads/per-read-output join"
            def names = workflow.trace.tasks().collect { it.name }
            assert names.any { it.contains('EXTRACT_READS_BY_TAXID') && it.contains('barcode01') } :
                "barcode01 was not discovered from the incremental layout; tasks: ${names}"
            assert !names.any { it.contains('barcode01.cumulative') } :
                "the cumulative file was taken for a sample of its own; tasks: ${names}"
        }
    }
}
