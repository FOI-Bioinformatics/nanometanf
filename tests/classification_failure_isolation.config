// Test-only config for the classification-failure case in
// tests/failure_paths.nf.test.
//
// conf/error_isolation.config sets
//
//     errorStrategy = { task.exitStatus in [1,2] ? 'ignore' : 'retry' }
//
// on all three KRAKEN2 processes, and 1/2 are their normal failure codes. A
// barcode whose classification dies is therefore absorbed: its QC output is
// intact, it simply emits no report, and the run reports success.
//
// Reproducing that with a real Kraken2 failure would need a database crafted to
// make the binary exit 1. ``ext.when = false`` reaches the same downstream
// state -- a skipped process emits nothing on its output channels -- without a
// database, a container, or the binary, which is the same technique
// tests/ifempty_sentinel_regression.config uses for CHOPPER.
//
// All three classifier processes are covered because which one runs depends on
// params.kraken2_enable_incremental and params.realtime_mode.

process {
    withName: 'KRAKEN2_KRAKEN2' {
        ext.when = false
    }
    withName: 'KRAKEN2_OPTIMIZED' {
        ext.when = false
    }
    withName: 'KRAKEN2_INCREMENTAL_CLASSIFIER' {
        ext.when = false
    }
}
