nextflow_pipeline {

    name "Test pre-demultiplexed barcode directory discovery"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "barcode_discovery"

    // Execution Speed & Criticality
    tag "slow"
    tag "core"

    test("Should discover and process pre-demultiplexed barcode folders") {

        when {
            params {
                // Use barcode directory input
                barcode_input_dir = "$projectDir/tests/fixtures/barcode_structure"
                outdir = "$outputDir"

                // Provide required input parameter (empty samplesheet for barcode mode)
                input = false
                pod5_input_dir = null
                use_dorado = false
                realtime_mode = false

                // Disable advanced features for focused testing
                skip_kraken2 = true
                blast_validation = false

                // Resource limits
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '1.h'
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/pipeline_info").exists()
            assert workflow.trace.tasks().size() > 0

            // Check QC ran for multiple barcode samples (barcode01, barcode02, unclassified)
            def qc_tasks = workflow.trace.tasks().findAll { it.name.contains('CHOPPER') || it.name.contains('FASTP') || it.name.contains('FILTLONG') }
            assert qc_tasks.size() >= 2  // At least 2 barcodes discovered and processed

            // Check output structure - default QC tool is CHOPPER
            assert path("${outputDir}/chopper").exists() || path("${outputDir}/fastp").exists()
            assert path("${outputDir}/multiqc").exists()
        }
    }

    test("Should handle empty barcode directories gracefully") {

        when {
            params {
                // Use a non-existent directory to test graceful handling
                input = false
                barcode_input_dir = "$projectDir/tests/fixtures/empty_barcode_structure"
                outdir = "$outputDir"

                skip_kraken2 = true
                use_dorado = false
                blast_validation = false
                // Resource limits
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '1.h'
            }
        }

        then {
            // Should handle gracefully - may fail or succeed with minimal tasks
            // The pipeline may detect no valid files and either exit cleanly or fail
            assert workflow.failed || workflow.success
        }
    }
}
