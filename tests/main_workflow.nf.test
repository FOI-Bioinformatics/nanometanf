nextflow_pipeline {

    name "Test complete nanometanf workflow"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "qc"
    tag "classification"

    // Execution Speed & Criticality
    tag "slow"
    tag "core"
    tag "stub"

    test("Should run complete workflow without failures") {

        when {
            params {
input = "$projectDir/tests/test_samplesheet.csv"
                outdir = "$outputDir"

                // Disable advanced features for basic test
                realtime_mode = false
                skip_kraken2 = true
                blast_validation = false

                // Enable QC steps
                skip_fastp = false
                skip_nanoplot = false

                // Resource limits for testing
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '1.h'
            }
        }

        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("${outputDir}/pipeline_info").exists()
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
            assert workflow.trace.tasks().size() > 0

            // Check that main processes ran (use contains() for process names with sample suffix)
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') || it.name.contains('FASTP') || it.name.contains('FILTLONG') }
            assert workflow.trace.tasks().any { it.name.contains('NANOPLOT') }
            assert workflow.trace.tasks().any { it.name.contains('MULTIQC') }

            // Check output directories exist - default QC tool is CHOPPER
            assert path("${outputDir}/chopper").exists() || path("${outputDir}/fastp").exists()
            assert path("${outputDir}/nanoplot").exists()
            assert path("${outputDir}/multiqc").exists()
        }
    }

    test("Should run the classification path when a database is provided") {

        // Stub mode against the stub-only DB fixture: this exercises the
        // classification wiring (and the EMIT_EMPTY_KRAKEN2_REPORT placeholder
        // path, since the QC stub yields an empty post-QC FASTQ) without needing
        // a real Kraken2 index. The previous version pointed at a nonexistent
        // tests/test_kraken2_db and asserted a tautology, so it verified nothing.
        options "-stub"
        when {
            params {
                input = "$projectDir/tests/test_samplesheet.csv"
                outdir = "$outputDir"
                kraken2_db = "$projectDir/tests/fixtures/kraken2_db"
                realtime_mode = false
                blast_validation = false
                skip_nanoplot = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }

        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
            assert workflow.trace.tasks().any {
                it.name.contains('KRAKEN2') || it.name.contains('EMIT_EMPTY_KRAKEN2_REPORT')
            }
            assert path("${outputDir}/kraken2").exists()
        }
    }

    test("Should run workflow with CHOPPER QC tool (default v1.1.0)") {

        when {
            params {
                input = "$projectDir/tests/test_samplesheet.csv"
                outdir = "$outputDir"

                // Explicitly test CHOPPER (default in v1.1.0)
                qc_tool = 'chopper'
                chopper_quality = 10
                chopper_minlength = 1000

                // Disable advanced features
                realtime_mode = false
                skip_kraken2 = true
                blast_validation = false

                // Enable QC steps
                skip_fastp = false
                skip_nanoplot = false

                // Resource limits
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '1.h'
            }
        }

        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success

            // Verify CHOPPER executed
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }

            // Verify standardized outputs exist
            assert workflow.trace.tasks().any { it.name.contains('FASTQC') } : "FastQC should run for enhanced reporting with CHOPPER"
            assert workflow.trace.tasks().any { it.name.contains('SEQKIT') } : "SeqKit should run for enhanced reporting with CHOPPER"
            assert workflow.trace.tasks().any { it.name.contains('MULTIQC') }

            // Verify MultiQC can integrate CHOPPER data
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
        }
    }

    test("Should run workflow with FASTP QC tool") {

        when {
            params {
                input = "$projectDir/tests/test_samplesheet.csv"
                outdir = "$outputDir"

                // Test FASTP
                qc_tool = 'fastp'

                // Disable advanced features
                realtime_mode = false
                skip_kraken2 = true
                blast_validation = false

                // Enable QC steps
                skip_fastp = false
                skip_nanoplot = false

                // Resource limits
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '1.h'
            }
        }

        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success

            // Verify FASTP executed
            assert workflow.trace.tasks().any { it.name.contains('FASTP') }

            // Verify standardized outputs exist
            assert workflow.trace.tasks().any { it.name.contains('NANOPLOT') }
            assert workflow.trace.tasks().any { it.name.contains('MULTIQC') }

            // Verify MultiQC can integrate FASTP data
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
        }
    }
}
