nextflow_pipeline {

    name "Full Pipeline Integration Test - Stub Mode (Dependency-Free)"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "qc"
    tag "classification"
    tag "validation"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    // Test Type
    tag "stub"

    // The former leaner CHOPPER+kraken2 case (no blast, no nanoplot) was removed:
    // it was a subset of "complete QC pipeline" below, which already exercises
    // CHOPPER + kraken2 plus blast validation and NanoPlot.

    test("Should run complete QC pipeline in stub mode") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/minimal.csv"
                outdir = "$outputDir"

                qc_tool = 'chopper'
                classifier = 'kraken2'
                kraken2_db = "$projectDir/tests/fixtures/kraken2_db"
                blast_validation = true
                blast_db = "$projectDir/tests/fixtures/blast_db/test_db"

                chopper_quality = 10
                chopper_minlength = 1000
                skip_nanoplot = false

                taxpasta_format = 'tsv'
                kraken2_save_output_fastqs = false
                kraken2_save_readclassifications = false

                realtime_mode = false

                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        options "-stub"

        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }
            assert path("${outputDir}/kraken2").exists()
        }
    }

    test("Should validate tool-agnostic QC interface with FASTP in full pipeline") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/minimal.csv"
                outdir = "$outputDir"

                qc_tool = 'fastp'
                fastp_qualified_quality = 15
                fastp_length_required = 1000

                classifier = 'kraken2'
                kraken2_db = "$projectDir/tests/fixtures/kraken2_db"
                taxpasta_format = 'tsv'

                blast_validation = false
                realtime_mode = false
                skip_nanoplot = true

                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        options "-stub"

        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
            assert workflow.trace.tasks().any { it.name.contains('FASTP') }
        }
    }

    test("Should validate minimal pipeline without classification (QC-only workflow)") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/minimal.csv"
                outdir = "$outputDir"

                qc_tool = 'chopper'
                chopper_quality = 10
                chopper_minlength = 1000

                skip_kraken2 = true
                blast_validation = false

                realtime_mode = false
                skip_nanoplot = false

                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        options "-stub"

        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }
        }
    }
}
