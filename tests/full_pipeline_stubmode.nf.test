nextflow_pipeline {

    name "Full Pipeline Integration Test - Stub Mode (Dependency-Free)"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "qc"
    tag "classification"
    tag "validation"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    // Test Type
    tag "stub"

    test("Should run complete QC pipeline in stub mode") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/minimal.csv"
                outdir = "$outputDir"

                qc_tool = 'chopper'
                classifier = 'kraken2'
                kraken2_db = "$projectDir/tests/fixtures/kraken2_db"
                blast_validation = true
                blast_db = "$projectDir/tests/fixtures/blast_db/test_db"

                chopper_quality = 10
                chopper_minlength = 1000
                skip_nanoplot = false

                taxpasta_format = 'tsv'
                kraken2_save_output_fastqs = false
                kraken2_save_readclassifications = false

                realtime_mode = false

                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        options "-stub"

        then {
            assert workflow.success
        }
    }

    test("Should validate tool-agnostic QC interface with FASTP in full pipeline") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/minimal.csv"
                outdir = "$outputDir"

                qc_tool = 'fastp'
                fastp_qualified_quality = 15
                fastp_length_required = 1000

                classifier = 'kraken2'
                kraken2_db = "$projectDir/tests/fixtures/kraken2_db"
                taxpasta_format = 'tsv'

                use_dorado = false
                blast_validation = false
                realtime_mode = false
                skip_nanoplot = true

                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        options "-stub"

        then {
            assert workflow.success
        }
    }

    test("Should validate tool-agnostic QC interface with CHOPPER in full pipeline") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/minimal.csv"
                outdir = "$outputDir"

                // Use CHOPPER (default QC tool) - FILTLONG has known configuration issue
                qc_tool = 'chopper'
                chopper_quality = 8
                chopper_minlength = 500

                classifier = 'kraken2'
                kraken2_db = "$projectDir/tests/fixtures/kraken2_db"
                taxpasta_format = 'tsv'

                use_dorado = false
                blast_validation = false
                realtime_mode = false
                skip_nanoplot = true

                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        options "-stub"

        then {
            assert workflow.success
        }
    }

    test("Should validate minimal pipeline without classification (QC-only workflow)") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/minimal.csv"
                outdir = "$outputDir"

                qc_tool = 'chopper'
                chopper_quality = 10
                chopper_minlength = 1000

                skip_kraken2 = true
                blast_validation = false

                realtime_mode = false
                skip_nanoplot = false

                max_cpus = 2
                max_memory = '4.GB'
                max_time = '5.min'
            }
        }

        options "-stub"

        then {
            assert workflow.success
        }
    }
}
