// Test batch mode processing with POD5 files using Dorado basecalling
// This tests the use_dorado and pod5_input_dir parameters for static basecalling mode
nextflow_pipeline {

    name "Test batch mode with POD5 files"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"
    tag "batch"

    // Feature Area (use standard tags from TAGGING_GUIDE.md)
    tag "basecalling"

    // Execution Speed & Criticality
    tag "slow"
    tag "extended"

    test("Should process flat POD5 files with Dorado basecalling") {

        when {
            params {
                // POD5 basecalling mode
                use_dorado = true
                pod5_input_dir = "$projectDir/tests/fixtures/pod5"
                dorado_model = "dna_r10.4.1_e4.3_400bps_fast"
                outdir = "$outputDir"

                // Disable real-time and other features
                realtime_mode = false
                kraken2_db = null
                blast_validation = false
                skip_nanoplot = true

                // Resource limits
                max_cpus = 2
                max_memory = '8.GB'
                max_time = '30.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0

            // Check that Dorado basecalling ran
            assert workflow.trace.tasks().any { it.name.contains('DORADO') }

            // Check downstream QC ran
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }
        }
    }

    test("Should process barcode subdirectory POD5 files with Dorado") {

        when {
            params {
                // POD5 basecalling with barcode structure
                use_dorado = true
                pod5_input_dir = "$projectDir/tests/fixtures/pod5"
                file_pattern = "**/*.pod5"
                dorado_model = "dna_r10.4.1_e4.3_400bps_fast"
                outdir = "$outputDir"

                // Disable real-time and other features
                realtime_mode = false
                kraken2_db = null
                blast_validation = false
                skip_nanoplot = true

                // Resource limits
                max_cpus = 2
                max_memory = '8.GB'
                max_time = '30.min'
            }
        }

        then {
            assert workflow.success

            // Check that Dorado basecalling ran
            assert workflow.trace.tasks().any { it.name.contains('DORADO') }
        }
    }
}
