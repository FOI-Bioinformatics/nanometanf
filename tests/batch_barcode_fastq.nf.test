// Test batch mode processing with pre-demultiplexed barcode subdirectory structure
// This tests the barcode_input_dir parameter with FASTQ files organized in barcode01/, barcode02/ etc.
nextflow_pipeline {

    name "Test batch mode with barcode subdirectory FASTQ files"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"
    tag "batch"

    // Feature Area (use standard tags from TAGGING_GUIDE.md)
    tag "qc"
    tag "barcode_discovery"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    test("Should process barcode subdirectory FASTQ files in batch mode") {

        when {
            params {
                // Use barcode subdirectory structure
                barcode_input_dir = "$projectDir/tests/fixtures/barcode_structure"
                outdir = "$outputDir"

                // Disable real-time and advanced features
                realtime_mode = false
                use_dorado = false
                kraken2_db = null
                blast_validation = false
                skip_nanoplot = true

                // Resource limits for testing
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0

            // Check that barcode samples were discovered and processed
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }

            // Verify output structure
            assert path("${outputDir}/chopper").exists()
        }
    }

    test("Should process barcode subdirectory FASTQ files with samplesheet") {

        when {
            params {
                // Use samplesheet pointing to barcode files
                input = "$projectDir/tests/fixtures/samplesheets/multiple_fastq_barcodes.csv"
                outdir = "$outputDir"

                // Disable advanced features
                realtime_mode = false
                use_dorado = false
                kraken2_db = null
                blast_validation = false
                skip_nanoplot = true

                // Resource limits
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }

        then {
            assert workflow.success

            // Check that samples were processed
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }
            assert path("${outputDir}/chopper").exists()
        }
    }
}
