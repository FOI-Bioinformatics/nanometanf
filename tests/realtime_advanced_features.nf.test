nextflow_pipeline {

    name "Test Advanced Real-Time Features"
    script "main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "realtime"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    test("Real-time with timeout - should stop after timeout") {

        when {
            params {
                input = false
                outdir = "$outputDir"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "*.fastq.gz"
                max_files = 3
                realtime_timeout_minutes = 1
                realtime_processing_grace_period = 1
                skip_kraken2 = true
                skip_multiqc = true
                batch_size = 1
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Adaptive batching - should respect min/max constraints") {

        when {
            params {
                input = false
                outdir = "$outputDir"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "*.fastq.gz"
                max_files = 10
                adaptive_batching = true
                min_batch_size = 2
                max_batch_size = 5
                batch_size_factor = 2.0
                skip_kraken2 = true
                skip_multiqc = true
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Priority routing - priority samples should be marked") {

        when {
            params {
                input = false
                outdir = "$outputDir"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "*.fastq.gz"
                max_files = 5
                priority_samples = "test,control"
                skip_kraken2 = true
                skip_multiqc = true
                batch_size = 2
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Combined features - timeout + adaptive + priority") {

        when {
            params {
                input = false
                outdir = "$outputDir"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "*.fastq.gz"
                max_files = 10
                realtime_timeout_minutes = 2
                realtime_processing_grace_period = 1
                adaptive_batching = true
                min_batch_size = 1
                max_batch_size = 5
                priority_samples = "urgent,control"
                skip_kraken2 = true
                skip_multiqc = true
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Barcode extraction - should detect barcodes in filenames") {

        when {
            params {
                input = false
                outdir = "$outputDir"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "barcode*.fastq.gz"
                max_files = 5
                skip_kraken2 = true
                skip_multiqc = true
            }
        }

        then {
            assert workflow.success
        }
    }

    test("No timeout or max_files - should warn user") {

        when {
            params {
                input = false
                outdir = "$outputDir"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "*.fastq.gz"
                max_files = 3
                skip_kraken2 = true
                skip_multiqc = true
            }
        }

        then {
            assert workflow.success
        }
    }
}
