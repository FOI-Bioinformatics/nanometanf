// Test real-time mode with flat FASTQ files (non-barcoded)
// This tests watchPath monitoring of FASTQ files appearing in a directory
// Uses realtime_mode=true with nanopore_output_dir and max_files to limit processing
nextflow_pipeline {

    name "Test real-time mode with flat FASTQ files"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"
    tag "realtime"

    // Feature Area (use standard tags from TAGGING_GUIDE.md)
    tag "qc"

    // Execution Speed & Criticality
    tag "slow"
    tag "extended"

    test("Should process flat FASTQ files in real-time mode") {

        when {
            params {
                // Real-time mode with flat directory
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "*.fastq.gz"
                outdir = "$outputDir"

                // Critical: limit files to prevent watchPath hanging
                max_files = 4
                batch_size = 2

                // Disable advanced features
                use_dorado = false
                skip_kraken2 = true
                blast_validation = false
                skip_nanoplot = true
                enable_realtime_stats = false

                // Resource limits
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0

            // Check that files were processed
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }
            assert path("${outputDir}/chopper").exists()
        }
    }
}
