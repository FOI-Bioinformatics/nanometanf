// Real-time (watchPath) input handling, consolidated from the former
// realtime_barcode_fastq + realtime_flat_fastq tests. Runs in stub mode with a
// bounded watchPath (max_files + short realtime_timeout) so the JVM exits
// cleanly, and asserts the crash-signature guard, the software-versions
// artifact, and that the QC path ran -- not only workflow.success. Stays
// slow/extended because the watchPath timeout dominates wall-clock.
nextflow_pipeline {

    name "Real-time input modes (barcode subdir, flat directory)"
    script "../main.nf"

    tag "pipeline"
    tag "integration"
    tag "realtime"
    tag "qc"
    tag "barcode_discovery"
    tag "stub"
    tag "slow"
    tag "extended"

    test("barcode subdirectory FASTQ in real-time mode") {
        options "-stub"
        when {
            params {
                input = false
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/barcode_structure"
                file_pattern = "**/*.fastq.gz"
                outdir = "$outputDir"
                max_files = 3
                batch_size = 2
                realtime_timeout_minutes = 1
                realtime_processing_grace_period = 10
                skip_kraken2 = true
                blast_validation = false
                skip_nanoplot = true
                enable_realtime_stats = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }
        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') || it.name.contains('FASTP') }
        }
    }

    test("flat FASTQ directory in real-time mode") {
        options "-stub"
        when {
            params {
                input = false
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/fastq"
                file_pattern = "*.fastq.gz"
                outdir = "$outputDir"
                max_files = 4
                batch_size = 2
                realtime_timeout_minutes = 1
                realtime_processing_grace_period = 10
                skip_kraken2 = true
                blast_validation = false
                skip_nanoplot = true
                enable_realtime_stats = false
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }
        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') || it.name.contains('FASTP') }
        }
    }
}
