nextflow_pipeline {

    name "Test default pipeline run"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "qc"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    test("Should run with standard test profile") {

        when {
            params {
                input = "$projectDir/tests/test_samplesheet.csv"
                outdir = "$outputDir"

                // Use test profile parameters
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '2.min'

                // Disable heavy features for quick testing
                use_dorado = false
                skip_kraken2 = true
                blast_validation = false
                realtime_mode = false
            }
        }

        then {
            assert workflow.success
        }
    }
}
