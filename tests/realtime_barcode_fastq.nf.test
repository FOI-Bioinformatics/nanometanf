// Test real-time mode with pre-demultiplexed barcode subdirectory FASTQ files
// This tests the watchPath monitoring of barcode01/, barcode02/ subdirectories
// Uses realtime_mode=true with nanopore_output_dir pointing to barcode structure
nextflow_pipeline {

    name "Test real-time mode with barcode subdirectory FASTQ files"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"
    tag "realtime"

    // Feature Area (use standard tags from TAGGING_GUIDE.md)
    tag "qc"
    tag "barcode_discovery"

    // Execution Speed & Criticality
    tag "slow"
    tag "extended"

    test("Should process existing barcode FASTQ files in real-time mode") {

        when {
            params {
                input = false
                // Real-time mode with existing files
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/barcode_structure"
                file_pattern = "**/*.fastq.gz"
                outdir = "$outputDir"

                // Critical: limit files and set timeout to prevent watchPath hanging
                max_files = 3
                batch_size = 2
                realtime_timeout_minutes = 1
                realtime_processing_grace_period = 10

                // Disable advanced features
                skip_kraken2 = true
                blast_validation = false
                skip_nanoplot = true
                enable_realtime_stats = false

                // Resource limits
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0

            // Check that files were processed
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') }
            assert path("${outputDir}/chopper").exists()
        }
    }
}
