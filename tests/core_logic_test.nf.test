nextflow_pipeline {

    name "Test core pipeline logic without containers"
    script "../main.nf"

    // Test Level & Component
    tag "pipeline"
    tag "integration"

    // Feature Area
    tag "validation"

    // Execution Speed & Criticality
    tag "fast"
    tag "core"

    test("Should validate pipeline structure and parameter handling") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"
                
                // Use no-Docker configuration
                config_profile_name = 'Test without Docker'
                
                // Disable all container-dependent features
                use_dorado = false
                realtime_mode = false
                skip_kraken2 = true
                blast_validation = false
                
                // Skip container-dependent processes
                skip_fastp = true
                skip_nanoplot = true
                skip_multiqc = true
                
                // Disable dynamic features
                enable_dynamic_resources = false
                enable_realtime_stats = false
                
                // Resource limits
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '5.min'
            }
            
            config "$projectDir/conf/test_no_docker.config"
        }

        then {
            assert workflow.success
        }
    }

    test("Should handle minimal input validation without execution") {

        when {
            params {
                input = "$projectDir/tests/fixtures/samplesheets/test_samplesheet_absolute.csv"
                outdir = "$outputDir"
                
                // Force early exit for validation only
                help = false
                validate_params = true
                
                // Minimal configuration
                max_cpus = 1
                max_memory = '1.GB'
                max_time = '1.min'
                
                // Disable all execution
                use_dorado = false
                realtime_mode = false
                skip_kraken2 = true
                blast_validation = false
                skip_fastp = true
                skip_nanoplot = true
                skip_multiqc = true
            }
            
            config "$projectDir/conf/test_no_docker.config"
        }

        then {
            assert workflow.success
        }
    }

    test("Should detect missing critical dependencies gracefully") {

        when {
            params {
                input = false
                outdir = "$outputDir"
                
                skip_kraken2 = true
                // Enable features that require tools
                use_dorado = true
                dorado_path = "/nonexistent/path/dorado"
                pod5_input_dir = "$projectDir/tests/fixtures/pod5"
                
                // Resource limits
                max_cpus = 1
                max_memory = '2.GB'
                max_time = '2.min'
            }
            
            config "$projectDir/conf/test_no_docker.config"
        }

        then {
            assert workflow.success
        }
    }
}