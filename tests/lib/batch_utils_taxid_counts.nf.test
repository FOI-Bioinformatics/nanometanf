nextflow_function {

    name "Test BatchUtils.exactTaxidReadCounts (pre-extraction validation gate)"
    script "tests/lib/batch_utils_functions.nf"
    function "exactTaxidReadCounts"

    tag "unit"
    tag "fast"

    // The validation subworkflow gates EXTRACT_READS_BY_TAXID per (sample, taxid)
    // on this count (issue #6). It must match EXTRACT's own rule -- a classified
    // line ($1 == "C") counts toward its exact assigned taxid ($3) -- so that the
    // gate count equals what extraction would find. These cases pin that rule.

    test("counts classified reads per exact taxid, ignoring unclassified lines") {
        when {
            function {
                """
                input[0] = file('${projectDir}/tests/fixtures/validation/test_kraken_output.txt')
                """
            }
        }
        then {
            // The fixture holds 8 'C' lines for taxid 562 and unclassified ('U')
            // lines that must not be counted; no other taxid is classified.
            assert function.result == ['562': 8]
        }
    }

    // "unreadable" and "no classified reads" must not share a return value. The
    // gate drops any (sample, taxid) pair whose count is below the floor, so an
    // empty map for an unreadable file dropped EVERY pair and validation produced
    // nothing -- reported only at log.debug. That is what a work directory on S3
    // or Azure looked like, where the old java.io.File check never found the file.
    // null now means "no gate information" and the caller fails open.

    test("null input returns null, not an empty histogram") {
        when {
            function {
                """
                input[0] = null
                """
            }
        }
        then {
            assert function.result == null
        }
    }

    test("missing file returns null, not an empty histogram") {
        when {
            function {
                """
                input[0] = '/nonexistent/path/does_not_exist.txt'
                """
            }
        }
        then {
            assert function.result == null
        }
    }

    test("a readable file with no classified reads returns an empty map") {
        // The other side of the distinction: this file WAS read, and genuinely
        // holds nothing to validate, so the gate should skip its taxids.
        setup {
            file("${outputDir}/unclassified_only.txt").text = [
                'U\tread1\t0\t100\t0:100',
                'U\tread2\t0\t100\t0:100',
                ''
            ].join('\n')
        }
        when {
            function {
                """
                input[0] = file('${outputDir}/unclassified_only.txt')
                """
            }
        }
        then {
            assert function.result == [:]
        }
    }
}
