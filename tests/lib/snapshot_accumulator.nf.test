nextflow_function {

    name "Test ValidationSnapshotAccumulator (realtime live-aggregation state)"
    script "tests/lib/snapshot_accumulator_functions.nf"
    function "snapshotSequence"

    tag "unit"
    tag "fast"

    // The realtime validation live-aggregation cadence (issue #29) depends on
    // this accumulator: it must keep the latest file per key, re-emit the full
    // current set on every update, and flag an aggregation only on a per-batch
    // boundary thinned by the interval. These cases pin that behaviour so the
    // delicate maxForks=1 trigger cadence cannot silently regress.

    test("interval 1: every boundary triggers; latest file wins per key") {
        when {
            function {
                """
                input[0] = [
                    ['k1', 'f1',  false],
                    ['k2', 'f2',  false],
                    ['krak', 'r', true],
                    ['k1', 'f1b', false],
                    ['krak2', 'r2', true],
                ]
                input[1] = 1
                """
            }
        }
        then {
            assert function.result == [
                [false, ['f1']],
                [false, ['f1', 'f2']],
                [true,  ['f1', 'f2', 'r']],
                [false, ['f1b', 'f2', 'r']],
                [true,  ['f1b', 'f2', 'r', 'r2']],
            ]
        }
    }

    test("interval 2: only every second boundary triggers") {
        when {
            function {
                """
                input[0] = [
                    ['krak1', 'r1', true],
                    ['krak2', 'r2', true],
                ]
                input[1] = 2
                """
            }
        }
        then {
            assert function.result == [
                [false, ['r1']],
                [true,  ['r1', 'r2']],
            ]
        }
    }

    test("interval 0 means end-of-session only: no boundary ever triggers") {
        // params.validation_aggregate_interval defaults to 0, and both
        // nextflow.config and nextflow_schema.json document 0 as "end-of-session
        // only". A Math.max(1, interval) floor used to turn that into "aggregate
        // on every batch" -- the issue #29 load, reinstated by default, with no
        // value left that could ask for the documented behaviour.
        //
        // The snapshot must still be maintained: the caller's end-of-session
        // .last() emission publishes it, so the final set has to be complete.
        when {
            function {
                """
                input[0] = [
                    ['krak1', 'r1', true],
                    ['stat', 'f1', false],
                    ['krak2', 'r2', true],
                    ['krak3', 'r3', true],
                ]
                input[1] = 0
                """
            }
        }
        then {
            assertAll(
                { assert function.result.every { !it[0] } },
                // The set the end-of-session emission will carry.
                { assert function.result[-1][1] == ['r1', 'f1', 'r2', 'r3'] }
            )
        }
    }

    test("a negative interval is treated as end-of-session only, not as every batch") {
        // The schema floors at 0, so this is defensive: whatever a negative
        // value means, it must not mean "aggregate constantly".
        when {
            function {
                """
                input[0] = [
                    ['krak1', 'r1', true],
                    ['krak2', 'r2', true],
                ]
                input[1] = -1
                """
            }
        }
        then {
            assert function.result.every { !it[0] }
        }
    }

    test("stat-only updates never trigger an aggregation") {
        when {
            function {
                """
                input[0] = [
                    ['a', 'fa', false],
                    ['b', 'fb', false],
                ]
                input[1] = 1
                """
            }
        }
        then {
            assert function.result == [
                [false, ['fa']],
                [false, ['fa', 'fb']],
            ]
        }
    }
}
