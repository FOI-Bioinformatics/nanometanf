nextflow_function {

    name "Test CrossBatchInterleaver (cross-batch per-barcode fairness)"
    script "tests/lib/cross_batch_interleaver_functions.nf"
    function "crossBatchOrder"

    tag "unit"
    tag "fast"

    // The classifier maxForks is global, so the flattened per-file order is the
    // classification order. This interleaver carries per-sample served-counts
    // across batches so a sample that fell behind is drained first later (audit
    // P2.9). These cases pin both the within-batch round-robin and the cross-batch
    // catch-up.
    //
    // Keys come from the resolved sample id, through BatchUtils.sampleKeyOf,
    // so this interleaver and the stateless one it follows cannot disagree.
    // The flat-layout case below is the one the parent-directory key failed
    // (audit F1, docs/performance/realtime_many_barcodes_audit_2026-10-26.md).

    test("single batch with empty history is a plain round-robin") {
        when {
            function {
                """
                input[0] = [[
                    file('d/barcode01/a.fastq.gz'),
                    file('d/barcode01/b.fastq.gz'),
                    file('d/barcode02/c.fastq.gz'),
                    file('d/barcode02/d.fastq.gz'),
                ]]
                """
            }
        }
        then {
            // bc01/a, bc02/c, bc01/b, bc02/d -- one from each sample per round,
            // identical to the stateless interleaveFilesBySample.
            assert function.result == [['a.fastq.gz', 'c.fastq.gz', 'b.fastq.gz', 'd.fastq.gz']]
        }
    }

    test("a barcode behind across batches is drained first even if alphabetically last") {
        when {
            function {
                """
                input[0] = [
                    [ file('d/barcode01/p1.fastq.gz'),
                      file('d/barcode01/p2.fastq.gz'),
                      file('d/barcode01/p3.fastq.gz') ],
                    [ file('d/barcode01/p4.fastq.gz'),
                      file('d/barcode99/q1.fastq.gz') ],
                ]
                """
            }
        }
        then {
            // Batch 1 is all barcode01 (served01 = 3). In batch 2 barcode99 has
            // served 0, so it wins the first slot despite sorting after barcode01.
            assert function.result == [
                ['p1.fastq.gz', 'p2.fastq.gz', 'p3.fastq.gz'],
                ['q1.fastq.gz', 'p4.fastq.gz'],
            ]
        }
    }

    test("files within a barcode keep stable name order; no loss") {
        when {
            function {
                """
                input[0] = [[
                    file('d/barcode01/b.fastq.gz'),
                    file('d/barcode01/a.fastq.gz'),
                ]]
                """
            }
        }
        then {
            assert function.result == [['a.fastq.gz', 'b.fastq.gz']]
        }
    }

    test("empty batch yields an empty list") {
        when {
            function {
                """
                input[0] = [[]]
                """
            }
        }
        then {
            assert function.result == [[]]
        }
    }

    test("flat directory, sample from filename: fair within and across batches") {
        // One parent directory (fastq_pass/), three samples resolved from the
        // filename. Under the parent-directory key all nine files were one
        // group, every batch was emitted in name order, and barcode03 waited
        // for the whole backlog of the other two.
        when {
            function {
                """
                input[0] = [
                    [ file('d/fastq_pass/barcode01_000.fastq.gz'),
                      file('d/fastq_pass/barcode01_001.fastq.gz'),
                      file('d/fastq_pass/barcode02_000.fastq.gz') ],
                    [ file('d/fastq_pass/barcode01_002.fastq.gz'),
                      file('d/fastq_pass/barcode03_000.fastq.gz') ],
                ]
                """
            }
        }
        then {
            // Batch 1 round-robins bc01/bc02 and leaves bc01 served twice.
            // Batch 2 gives bc03 (served 0) the first slot ahead of bc01.
            assert function.result == [
                ['barcode01_000.fastq.gz', 'barcode02_000.fastq.gz', 'barcode01_001.fastq.gz'],
                ['barcode03_000.fastq.gz', 'barcode01_002.fastq.gz'],
            ]
        }
    }
}
