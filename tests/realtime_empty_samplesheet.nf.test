nextflow_pipeline {

    name "Test real-time processing with empty samplesheet (input=false)"
    script "../main.nf"

    tag "pipeline"
    tag "integration"
    tag "realtime"
    tag "stub"
    tag "slow"
    tag "extended"

    // NOTE: the former "non-existent directory" case was removed. A realtime
    // watchPath on a missing directory does NOT fail fast -- it keeps the watch
    // queue open and hangs (max_time is a per-task limit and there are no
    // tasks). That is a pipeline robustness gap (a missing nanopore_output_dir
    // should be rejected up front), flagged as a follow-up; a test that hangs CI
    // is worse than no test. The cases below use existing directories bounded by
    // max_files + realtime_timeout_minutes so they always terminate.

    test("empty samplesheet + realtime mode, pre-existing files (flat)") {
        options "-stub"
        when {
            params {
                input = false
                outdir = "$outputDir"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/realtime_test_data"
                file_pattern = "*.fastq.gz"
                batch_size = 2
                max_files = 2
                realtime_timeout_minutes = 1
                realtime_processing_grace_period = 10
                skip_kraken2 = true
                blast_validation = false
                skip_fastp = false
                skip_nanoplot = true
                max_cpus = 2
                max_memory = '4.GB'
                max_time = '15.min'
            }
        }
        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
            assert workflow.trace.tasks().any { it.name.contains('CHOPPER') || it.name.contains('FASTP') }
        }
    }

    test("empty samplesheet + realtime mode, pre-existing files (fixtures/realtime)") {
        options "-stub"
        when {
            params {
                input = false
                outdir = "$outputDir"
                realtime_mode = true
                nanopore_output_dir = "$projectDir/tests/fixtures/realtime"
                file_pattern = "*.fastq.gz"
                batch_size = 5
                max_files = 2
                realtime_timeout_minutes = 1
                realtime_processing_grace_period = 10
                skip_kraken2 = true
                blast_validation = false
                skip_nanoplot = true
                max_cpus = 2
                max_memory = '2.GB'
                max_time = '15.min'
            }
        }
        then {
            def err = (workflow.errorReport ?: '') + '\n' + (workflow.stdout?.join('\n') ?: '')
            assert !err.contains('MethodSelectionException')
            assert !err.contains('Could not find which method')
            assert !err.contains('MissingMethodException')
            assert !err.contains('Invalid method invocation `call`')
            assert workflow.success
            assert path("$outputDir/pipeline_info").list().any { it.toString().contains('software_') }
        }
    }
}
